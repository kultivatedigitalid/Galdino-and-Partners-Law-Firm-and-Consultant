{
  "name": "galdino-partner-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "astro check",
    "validate": "node --import tsx scripts/validate-project.mjs",
    "qa": "npm run check && npm test && npm run build && npm run validate",
    "preview": "astro preview",
    "astro": "astro",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --import tsx --test scripts/contact.test.ts scripts/service-search.test.ts",
    "docs:inventory": "node --import tsx scripts/generate-inventory.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "nodemailer": "^10.0.12",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/nodemailer": "^8.0.2",
    "cheerio": "^1.2.0",
    "lighthouse": "^13.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
