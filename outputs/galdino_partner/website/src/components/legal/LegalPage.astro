---
import {experienceImages} from '../../data/experience-images';
import BaseLayout from '../../layouts/BaseLayout.astro';import ImageHero from '../shared/ImageHero.astro';import {LEGAL} from '../../data/legal';import type {Locale} from '../../data/site';
interface Props{locale:Locale;page:'privacy'|'terms'}const {locale,page}=Astro.props;const id=locale==='id';const title=page==='privacy'?(id?'Kebijakan Privasi':'Privacy Policy'):(id?'Syarat & Ketentuan':'Terms & Conditions');const sections=LEGAL[page][locale];
---
<BaseLayout immersive locale={locale} title={title+' | Galdino & Partner'} description={id?'Cara Galdino & Partner mengelola informasi, privasi, serta ketentuan penggunaan website dan konsultasi.':'How Galdino & Partner manages information, privacy and the terms of website use and consultations.'}>
<div class="editorial"><ImageHero locale={locale} title={title} image={experienceImages.compliance} breadcrumbs={[{name:title}]}/><div class="container-shell"><p class="ed-lead">{id?'Diperbarui':'Updated'}: <time datetime={LEGAL.updated}>29 September 2026</time></p></div><div class="container-shell ed-section ed-split"><div class="ed-story">{sections.map((s,i)=><section aria-labelledby={'legal-'+i}><h2 id={'legal-'+i}>{i+1}. {s.title}</h2><p>{s.body}</p></section>)}<p><a href="mailto:halo@kultivate.id">halo@kultivate.id</a></p></div><aside class="ed-toc"><h2>{id?'Di halaman ini':'On this page'}</h2><ol>{sections.map((s,i)=><li><a href={'#legal-'+i}>{s.title}</a></li>)}</ol>{page==='privacy'&&<button class="ed-button secondary" data-cookie-preferences>{id?'Preferensi cookie':'Cookie preferences'}</button>}</aside></div></div></BaseLayout>
