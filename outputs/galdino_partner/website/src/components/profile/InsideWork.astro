---
import {Image} from 'astro:assets';
import discussion from '../../assets/company-carousel-01.webp';
import review from '../../assets/experience-compliance-review.png';
import site from '../../assets/experience-investment-project.png';
import meeting from '../../assets/company-carousel-04.webp';
import office from '../../assets/company-carousel-02.webp';
import team from '../../assets/profile-company-hero-centered.webp';
import type {Locale} from '../../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id';
const images=[{image:discussion,alt:id?'Diskusi kebutuhan izin':'Discussing permit requirements'},{image:review,alt:id?'Meninjau dokumen kepatuhan':'Reviewing compliance records'},{image:site,alt:id?'Konteks proyek lapangan':'Project site context'},{image:meeting,alt:id?'Koordinasi tim pendamping':'Support team coordination'},{image:office,alt:id?'Pekerjaan di kantor':'Work at the office'},{image:team,alt:id?'Tim hukum dan perizinan':'Legal and licensing team'}];
---
<section class="inside-work editorial"><div class="container-shell"><p class="ed-kicker">{id?'Di balik pekerjaan':'Inside the work'}</p><h2>{id?'Mendengar, memeriksa, dan menghubungkan.':'Listening, reviewing, and connecting.'}</h2><div class="work-collage">{images.map(item=><figure><Image src={item.image} alt={item.alt} widths={[400,800,1200]} sizes="(min-width:800px) 40vw,50vw" loading="lazy" quality={78}/></figure>)}</div></div></section>
<style>.inside-work{padding:var(--brand-section-space) 0;background:var(--brand-surface-soft)}.inside-work h2{font-size:clamp(1.5rem,3.3vw,2.75rem);max-width:none}.work-collage{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:repeat(3,9rem);gap:1rem;margin-top:2.5rem}.work-collage figure{margin:0;overflow:hidden;grid-column:span 3}.work-collage figure:first-child{grid-column:span 5;grid-row:span 2}.work-collage figure:nth-child(2){grid-column:span 4}.work-collage figure:nth-child(4){grid-column:span 7}.work-collage figure:nth-child(5){grid-column:span 4}.work-collage figure:nth-child(6){grid-column:span 8}.work-collage :global(img){width:100%;height:100%;object-fit:cover;object-position:center}@media(max-width:800px){.work-collage{grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(4,7rem);gap:.6rem}.work-collage figure,.work-collage figure:first-child,.work-collage figure:nth-child(2),.work-collage figure:nth-child(4),.work-collage figure:nth-child(5),.work-collage figure:nth-child(6){grid-column:span 2}.work-collage figure:nth-child(6){grid-column:span 4}}</style>
