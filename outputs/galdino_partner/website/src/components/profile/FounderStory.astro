---
import {Image} from 'astro:assets';
import portrait from '../../assets/team-hans-galdino.webp';
import detail from '../../assets/company-carousel-02.webp';
import {ABOUT} from '../../data/about';
import type {Locale} from '../../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id',c=ABOUT[locale];
---
<div class="editorial founder-story">
<div class="container-shell">
<section class="ed-section founder-note"><figure><Image src={portrait} alt="Hans Galdino" widths={[400,700,1000]} sizes="(min-width:800px) 40vw, 100vw" loading="lazy" quality={82}/><figcaption>Hans Galdino / Founder &amp; CEO</figcaption></figure><div><p class="ed-kicker">{id?'Catatan pendiri':'A note from our founder'}</p><h2>{id?'Kejelasan memberi ruang untuk melangkah.':'Clarity creates room to move forward.'}</h2><blockquote>{c.note}</blockquote><a class="ed-link" href={'/'+locale+'/profile/hans-galdino/'}>{id?'Kenali Hans Galdino':'Meet Hans Galdino'} →</a></div></section>
<section class="ed-section story-timeline"><div><p class="ed-kicker">{id?'Perjalanan kami':'Our story'}</p><h2>{id?'Tumbuh melalui pekerjaan yang kami tekuni.':'Shaped by the work we do.'}</h2></div><ol>{c.milestones.map(([year,title,copy])=><li><span>{year}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
<section class="ed-section principles"><div><p class="ed-kicker">{id?'Prinsip kerja':'Working principles'}</p><h2>{id?'Cara kami menjaga arah.':'How we keep work on course.'}</h2><Image src={detail} alt={id?'Tim meninjau kebutuhan dan dokumen bersama':'Team reviewing requirements and documents together'} widths={[480,800]} sizes="(min-width:800px) 40vw, 100vw" loading="lazy" quality={78}/></div><ol>{c.principles.map(([title,copy],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
</div></div>
<style>
.founder-story{background:var(--brand-paper)}
.founder-note{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(2rem,5vw,4rem);align-items:center;padding-block:clamp(2rem,4vw,3rem)}
.founder-note figure{margin:0;width:100%;max-width:20rem;justify-self:center}
.founder-note :global(img){display:block;width:100%;height:auto;aspect-ratio:4/5;max-height:22rem;object-fit:cover;object-position:center;filter:grayscale(1)}
.founder-note figcaption{border-bottom:1px solid var(--brand-line-strong);padding:.7rem 0;font-size:.75rem}
.founder-note h2{max-width:20ch}
.founder-note blockquote{font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.65;margin:1.25rem 0;color:var(--brand-muted)}
.story-timeline{display:grid;grid-template-columns:1fr 1.3fr;gap:4rem}
.story-timeline ol,.principles ol{list-style:none;padding:0;margin:0}
.story-timeline li{display:grid;grid-template-columns:6rem 1fr;gap:1.5rem;border-top:1px solid var(--brand-line-strong);padding:1.5rem 0}
.story-timeline li>span{color:var(--brand-red);font-size:1.1rem;font-weight:600}
.story-timeline li p{font-size:.9rem;color:var(--brand-muted);margin:0}
.principles{display:grid;grid-template-columns:1fr 1fr;gap:4rem}
.principles :global(img){width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:center;filter:grayscale(1);margin-top:2rem}
.principles ol{margin-top:2.75rem}
.principles li{display:grid;grid-template-columns:4rem 1fr;gap:1.3rem;border-top:1px solid var(--brand-line-strong);padding:1.5rem 0}
.principles li>span{font-size:3rem;line-height:1;color:var(--brand-red);letter-spacing:-.08em}
.principles li p{font-size:.9rem;color:var(--brand-muted);margin:0}
@media(max-width:800px){
 .founder-note,.story-timeline,.principles{grid-template-columns:1fr;gap:1.5rem}
 .founder-note figure{max-width:10.5rem}
 .founder-note :global(img){max-height:12rem}
 .founder-note figcaption{padding:.5rem 0;font-size:.65rem}
 .founder-note h2{max-width:none}
 .founder-note blockquote{font-size:.95rem;line-height:1.6;margin:1rem 0}
 .principles ol{margin-top:0}
 .story-timeline li{grid-template-columns:5rem 1fr;gap:1rem}
}
</style>
