---
import {Image} from 'astro:assets';
import portrait from '../../assets/team-hans-galdino.webp';

import {ABOUT} from '../../data/about';
import type {Locale} from '../../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id',c=ABOUT[locale];
---
<div class="editorial founder-story">
<div class="container-shell">
<section class="ed-section founder-note"><figure><Image src={portrait} alt="Hans Galdino" widths={[400,700,1000]} sizes="(min-width:800px) 40vw, 100vw" loading="lazy" quality={82}/><figcaption>Hans Galdino / Founder &amp; CEO</figcaption></figure><div><p class="ed-kicker">{id?'Catatan pendiri':'A note from our founder'}</p><h2>{id?'Kejelasan memberi ruang untuk melangkah.':'Clarity creates room to move forward.'}</h2><blockquote>{c.note}</blockquote><a class="ed-link" href={'/'+locale+'/profile/hans-galdino/'}>{id?'Kenali Hans Galdino':'Meet Hans Galdino'} →</a></div></section>
<section class="ed-section story-timeline"><div><p class="ed-kicker">{id?'Perjalanan kami':'Our story'}</p><h2>{id?'Tumbuh melalui pekerjaan yang kami tekuni.':'Shaped by the work we do.'}</h2></div><ol>{c.milestones.map(([year,title,copy])=><li><span>{year}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
<section class="ed-section principles"><div><p class="ed-kicker">{id?'Prinsip kerja':'Working principles'}</p><h2>{id?'Cara kami menjaga arah.':'How we keep work on course.'}</h2></div><ol>{c.principles.map(([title,copy],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></section>
</div></div>
<style>.founder-story{background:#f4f3f1}.founder-note{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(2rem,6vw,6rem);align-items:center}.founder-note figure{margin:0}.founder-note :global(img){width:100%;height:auto;aspect-ratio:4/5;object-fit: contain;object-position: center;filter:grayscale(1)}.founder-note figcaption{border-bottom:1px solid #bbb;padding:1rem 0;font-size:.8rem}.founder-note blockquote{font-size:clamp(1.15rem,2vw,1.7rem);line-height:1.6;margin:2rem 0;color:#46464a}.story-timeline{display:grid;grid-template-columns:1fr 1.3fr;gap:4rem}.story-timeline ol,.principles ol{list-style:none;padding:0;margin:0}.story-timeline li{display:grid;grid-template-columns:6rem 1fr;gap:1.5rem;border-top:1px solid #b6b2ad;padding:1.5rem 0}.story-timeline li>span{color:#971124;font-size:1.1rem;font-weight:600}.story-timeline li p{font-size:.9rem;color:#56565b;margin:0}.principles{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.principles :global(img){width:100%;height:auto;aspect-ratio:4/3;object-fit: contain;filter:grayscale(1);margin-top:2rem}.principles li{display:grid;grid-template-columns:4rem 1fr;gap:1.3rem;border-top:1px solid #b6b2ad;padding:1.5rem 0}.principles li>span{font-size:3rem;line-height:1;color:#971124;letter-spacing:-.08em}.principles li p{font-size:.9rem;color:#56565b;margin:0}@media(max-width:800px){.founder-note,.story-timeline,.principles{grid-template-columns:1fr;gap:2rem}.founder-note figure{max-width:32rem}.story-timeline li{grid-template-columns:5rem 1fr;gap:1rem}}</style>

<style>.founder-note.ed-section{padding-block:clamp(2rem,4vw,3rem);gap:clamp(2rem,5vw,4rem)}.founder-note figure{max-width:22rem;justify-self:center}.founder-note :global(img){aspect-ratio:4/5;max-height:24rem;object-fit:cover}.founder-note h2{font-size:clamp(1.8rem,3vw,2.5rem)}.founder-note blockquote{font-size:1.05rem;line-height:1.65;margin:1.25rem 0}.founder-note figcaption{padding:.7rem 0}.principles{grid-template-columns:1fr;gap:2rem}.principles h2{max-width:none}.principles ol{display:grid;grid-template-columns:1fr 1fr;gap:0 2.5rem}.principles li:last-child{grid-column:1/-1;grid-template-columns:2.5rem minmax(0,32rem);justify-content:center}.principles li>span{font-size:1.5rem;letter-spacing:0}.principles li{grid-template-columns:2.5rem 1fr}@media(max-width:600px){.principles ol{grid-template-columns:1fr}.founder-note figure{max-width:18rem}}</style>
