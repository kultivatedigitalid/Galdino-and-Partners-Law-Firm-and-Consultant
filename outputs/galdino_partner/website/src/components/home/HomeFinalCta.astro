---
import { COPY, SITE, type Locale } from '../../data/site';
import ArrowIcon from '../icons/ArrowIcon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const id = locale === 'id';
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container-shell final-cta__inner">
    <div data-home-reveal data-profile-reveal>
      <p class="final-cta__kicker">{id ? 'Mulai pengurusan izin' : 'Start your permit process'}</p>
      <h2 id="final-cta-title">{id ? 'Siap mengurus izin bisnis Anda?' : 'Ready to handle your business permits?'}</h2>
      <p class="final-cta__body">{id ? 'Sampaikan aktivitas, lokasi, dan target Anda. Kami mulai dengan asesmen kebutuhan dan ruang lingkup yang jelas.' : 'Share your activity, location, and target. We begin with a clear needs assessment and scope.'}</p>
    </div>
    <div class="final-cta__actions" data-home-reveal data-profile-reveal>
      <a class="final-cta__button" href={`/${locale}/contact/`}>{COPY[locale].consult}<ArrowIcon /></a>
      <a class="final-cta__whatsapp" href={SITE.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp {SITE.whatsappDisplay}<ArrowIcon direction="right" /></a>
    </div>
  </div>
</section>

<style>
  .final-cta { position: relative; overflow: clip; background: var(--brand-red); color: #fff; }
  .final-cta::after { position: absolute; right: -12rem; bottom: -25rem; width: 44rem; aspect-ratio: 1; border: 8rem solid rgb(0 0 0 / .14); border-radius: 50%; content: ''; }
  .final-cta__inner { position: relative; z-index: 1; display: grid; gap: 2.5rem; padding-block: clamp(4.5rem, 9vw, 8rem); }
  .final-cta__kicker { display: inline-flex; align-items: center; gap: .7rem; margin: 0; color: #fff; font-size: .7rem; font-weight: 820; letter-spacing: .12em; line-height: 1.35; text-transform: uppercase; }
  .final-cta__kicker::before { width: 1.8rem; height: 2px; flex: 0 0 auto; background: #fff; content: ''; }
  .final-cta h2 { max-width: 14ch; margin: 1.2rem 0 0; color: #fff; font-family: var(--font-display); font-size: var(--brand-type-section); font-weight: 570; letter-spacing: -.035em; line-height: 1.02; text-wrap: balance; }
  .final-cta__body { max-width: 42rem; margin: 1.5rem 0 0; color: rgb(255 255 255 / .84); font-size: .9rem; line-height: 1.65; }
  .final-cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.3rem; }
  .final-cta__button { min-height: 3.15rem; display: inline-flex; align-items: center; justify-content: center; gap: .7rem; border: 1px solid #fff; background: #fff; padding: .76rem 1.25rem; color: var(--brand-black); font-size: .78rem; font-weight: 800; line-height: 1.2; text-align: center; text-decoration: none; transition: transform 170ms var(--brand-ease), background-color 170ms var(--brand-ease), color 170ms var(--brand-ease); }
  .final-cta__button :global(.arrow-icon), .final-cta__whatsapp :global(.arrow-icon) { transition: transform 170ms var(--brand-ease); }
  .final-cta__button:active { transform: scale(.97); }
  .final-cta__whatsapp { min-height: 2.75rem; display: inline-flex; align-items: center; gap: .55rem; color: #fff; font-size: .76rem; font-weight: 780; text-decoration-color: rgb(255 255 255 / .62); text-underline-offset: .35rem; }
  @media (min-width: 900px) {
    .final-cta__inner { grid-template-columns: 1.3fr .7fr; align-items: end; }
    .final-cta__actions { justify-content: flex-end; flex-direction: column; align-items: flex-end; }
  }
  @media (hover: hover) and (pointer: fine) {
    .final-cta__button:hover { background: var(--brand-black); color: #fff; transform: translateY(-2px); }
    .final-cta__button:hover :global(.arrow-icon) { transform: translateX(3px); }
    .final-cta__whatsapp:hover :global(.arrow-icon) { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .final-cta__button, .final-cta__button :global(.arrow-icon), .final-cta__whatsapp :global(.arrow-icon) { transition-duration: .01ms; }
  }
</style>