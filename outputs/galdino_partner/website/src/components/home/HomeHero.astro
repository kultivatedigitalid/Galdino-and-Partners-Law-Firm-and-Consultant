---
import { Image } from 'astro:assets';
import architecture from '../../assets/home-architecture-supplied.webp';
import consultation from '../../assets/home-consultation-supplied-cutout.webp';
import ArrowIcon from '../icons/ArrowIcon.astro';
import HeroHighlight from '../shared/HeroHighlight.astro';
import { COPY, type Locale } from '../../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const id = locale === 'id';
const text = id ? {
 titleStart: 'Pengurusan Izin', titleEnd: 'untuk Bisnis Anda',
 lead: 'Kami petakan persyaratan, siapkan dokumen, dan kawal proses izin hingga tindak lanjut.',
 visual: 'Dua konsultan dan satu peserta konsultasi menelaah dokumen perizinan bersama.',
 note: 'Dari persyaratan ke pertumbuhan bisnis'
} : {
 titleStart: 'Business Permit Support', titleEnd: 'for Your Company',
 lead: 'We map requirements, prepare documents, and guide the permit process through follow-up.',
 visual: 'Two consultants and a consultation participant reviewing permit documents together.',
 note: 'From requirements to business growth'
};
---
<section class="home-hero" lang={locale} aria-labelledby="home-hero-title" data-hero-motion="ready">
 <Image class="home-hero__backdrop" data-hero-part="backdrop" src={architecture} alt="" aria-hidden="true" widths={[400,800,1200,1600,1784]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={85}/>
 <div class="container-shell home-hero__inner">
  <div class="home-hero__copy">
   <h1 id="home-hero-title" data-hero-part="title"><HeroHighlight text={text.titleStart}/>{' '}<span class="home-hero__title-end">{text.titleEnd}</span></h1>
   <p class="home-hero__lead" data-hero-part="lead">{text.lead}</p>
   <div class="home-hero__actions" data-hero-part="action"><a class="home-button home-button--red" href={'/' + locale + '/contact/'}>{COPY[locale].consult}<ArrowIcon/></a></div>
  </div>
 </div>
 <figure class="home-hero__visual" data-hero-part="visual">
  <Image class="home-hero__image" src={consultation} alt={text.visual} widths={[400,640,800,960,1280,1600]} sizes="(max-width:640px) 100vw, (max-width:1280px) 88vw, 70rem" loading="eager" fetchpriority="high" format="webp" quality={85}/>
 </figure>
</section>
<style>
.home-hero{position:relative;isolation:isolate;display:flex;flex-direction:column;min-height:max(42rem,100svh);overflow:clip;background:var(--home-paper,var(--brand-paper));color:var(--brand-black);--hero-scene-opacity:.46}
.home-hero :global(.home-hero__backdrop),.home-hero__visual{mix-blend-mode:multiply}
.home-hero :global(.home-hero__backdrop){position:absolute;inset:auto 0 3.5rem;z-index:-1;width:100%;height:64%;object-fit:cover;object-position:center bottom;opacity:var(--hero-scene-opacity);mask-image:linear-gradient(transparent,#000 40%,#000 78%,transparent),linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent);mask-composite:intersect;pointer-events:none}
.home-hero__inner{flex-shrink:0;position:relative;z-index:2;padding-top:calc(var(--site-header-height) + clamp(3.25rem,8svh,5.5rem));padding-bottom:1rem}
.home-hero__copy{width:100%;max-width:65rem;margin-inline:auto;text-align:center}
.home-hero h1{margin:0 auto;font-family:var(--font-display);font-size:var(--brand-type-hero);font-weight:570;letter-spacing:-.035em;line-height:.98;text-wrap:balance}
.home-hero__title-end{display:block;margin-top:.2em}
.home-hero__lead{max-width:43rem;margin:1.5rem auto 0;color:var(--brand-muted);font-size:clamp(.92rem,1.5vw,1.08rem);line-height:1.52;text-wrap:pretty}
.home-hero__actions{display:flex;justify-content:center;margin-top:1.5rem}
.home-hero__visual{position:relative;z-index:1;flex-shrink:0;width:min(88%,70rem);height:clamp(18rem,52svh,34rem);min-height:0;overflow:hidden;margin:0 auto}
.home-hero :global(.home-hero__image){width:100%;height:100%;object-fit:contain;object-position:center bottom}
@media(max-width:640px){
 .home-hero{height:auto;min-height:0}
 .home-hero__inner{padding-top:calc(var(--site-header-height) + 2.5rem)}
 .home-hero h1{max-width:20ch}
 .home-hero:lang(en) :global(.hero-highlight){font-size:.78em;white-space:nowrap}
 .home-hero__lead{font-size:var(--brand-type-lead);margin-top:1.25rem}
 .home-hero__visual{width:100%;height:auto;aspect-ratio:1784/882}
 .home-hero :global(.home-hero__backdrop){bottom:2rem;height:60%;object-position:20% bottom}
}
</style>
