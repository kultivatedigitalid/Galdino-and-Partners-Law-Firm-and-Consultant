---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageHero from './shared/ImageHero.astro';
import HomeFinalCta from './home/HomeFinalCta.astro';
import IndustryTiles from './shared/IndustryTiles.astro';
import PermitPathway from './shared/PermitPathway.astro';
import {INDUSTRIES} from '../data/industries';
import {heroImages} from '../data/hero-images';
import {SERVICE_CATEGORIES,categoryUrl} from '../data/service-catalog';
import type {Locale} from '../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id';
---
<BaseLayout immersive locale={locale} title={id?'Industri yang Kami Dampingi | Galdino & Partner':'Industries We Support | Galdino & Partner'} description={id?'Pemetaan kebutuhan perizinan untuk properti, manufaktur, gudang, retail, fasilitas kesehatan, dan hotel. Mulai dari konteks operasional Anda.':'Licensing requirements for property, manufacturing, warehouses, retail, healthcare and hotels. Start with your operating context.'}>
<div class="editorial">
<ImageHero locale={locale} title={id?'Berangkat dari dunia usaha Anda.':'Built around your business.'} description={id?'Lokasi, fasilitas, dan kegiatan membentuk kebutuhan izin yang berbeda. Kami mulai dari konteksnya.':'Location, facilities and activities shape different approval requirements. We start with that context.'} image={heroImages.industries} breadcrumbs={[{name:id?'Industri':'Industries'}]}/>
<nav class="sector-index container-shell" aria-label={id?'Pilih sektor':'Choose a sector'}>{INDUSTRIES.map((i,n)=><a href={'#sector-'+i.id}><span>0{n+1}</span>{i.content[locale].short} ↓</a>)}</nav>
<div class="container-shell">
<section class="ed-section"><IndustryTiles locale={locale}/></section>
<section class="ed-section"><p class="ed-kicker">{id?'Peta regulasi':'Regulatory landscape'}</p><h2>{id?'Satu kegiatan. Kebutuhan yang saling terhubung.':'One activity. Connected requirements.'}</h2><PermitPathway locale={locale} landscape/><p class="ed-note">{id?'Urutan dan kebutuhan akhir mengikuti jenis usaha, skala, lokasi, serta status dokumen. Peta ini merupakan titik awal asesmen.':'The final sequence and requirements depend on activity, scale, location and existing records. This map is a starting point for assessment.'}</p></section>
<section class="ed-section"><p class="ed-kicker">{id?'Bidang layanan':'Practice areas'}</p><div class="ed-related">{SERVICE_CATEGORIES.map(c=><article><h3><a href={categoryUrl(c,locale)}>{c.content[locale].title}</a></h3><p>{c.content[locale].description}</p></article>)}</div></section>
</div><HomeFinalCta locale={locale}/></div></BaseLayout>
<style>
.sector-index{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;padding-block:1rem;border-bottom:1px solid #bbb}
.sector-index a{font-size:.78rem;text-decoration:none;min-height:2.75rem;display:flex;align-items:center;gap:.5rem}
.sector-index a:hover{color:var(--brand-red)}.sector-index span{color:var(--brand-red);font-size:.65rem}
</style>
