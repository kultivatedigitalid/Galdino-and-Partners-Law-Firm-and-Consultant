---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { PROJECTS, SERVICES, type Locale } from '../data/site';

interface Props { locale: Locale; page: 'services' | 'projects'; }
const { locale, page } = Astro.props;
const id = locale === 'id';
const meta = {
  services: id
    ? { title: 'Layanan Hukum & Perizinan | Galdino & Partner', description: 'Layanan pendirian usaha, OSS-RBA, izin sektoral, kepatuhan, legal advisory, serta pendampingan proyek dan investasi.', eyebrow: 'Layanan', h1: 'Dukungan hukum dari pendirian hingga kepatuhan.', lead: 'Ruang lingkup dibentuk berdasarkan aktivitas, profil risiko, sektor, dan target bisnis, bukan paket generik yang sama untuk semua perusahaan.' }
    : { title: 'Legal & Licensing Services | Galdino & Partner', description: 'Company establishment, OSS-RBA, sectoral licensing, compliance, legal advisory, project, and investment assistance.', eyebrow: 'Services', h1: 'Legal support from establishment to compliance.', lead: 'Scope is shaped by activities, risk profile, sector, and business objectives, not a generic package for every company.' },
  projects: id
    ? { title: 'Pengalaman & Proyek | Galdino & Partner', description: 'Contoh pengalaman pendampingan legalitas usaha, kepatuhan regulasi, perizinan proyek, dan investasi.', eyebrow: 'Pengalaman', h1: 'Mandat yang disusun di sekitar kebutuhan klien.', lead: 'Kerahasiaan adalah prinsip utama. Contoh di bawah adalah struktur placeholder hingga detail yang layak publik telah disetujui.' }
    : { title: 'Experience & Projects | Galdino & Partner', description: 'Representative experience in business legality, regulatory compliance, project licensing, and investment assistance.', eyebrow: 'Experience', h1: 'Engagements structured around client needs.', lead: 'Confidentiality is fundamental. The examples below remain structured placeholders until public-facing details are approved.' },
}[page];
---

<BaseLayout locale={locale} title={meta.title} description={meta.description}>
  <PageHero eyebrow={meta.eyebrow} title={meta.h1} lead={meta.lead} />
  {page === 'services' && (
    <>
      <section class="section-space">
        <div class="container-shell">
          <div class="grid border-y border-line md:grid-cols-2">
            {SERVICES[locale].map((service) => (
              <article class="border-b border-line p-7 md:odd:border-r md:[&:nth-last-child(-n+2)]:border-b-0">
                <span class="text-xs font-bold text-gold">{service.number}</span>
                <h2 class="mt-8 font-display text-3xl">{service.title}</h2>
                <p class="mt-3 text-muted">{service.description}</p>
                <h3 class="mt-7 text-xs font-bold uppercase tracking-wider">{id ? 'Cakupan indikatif' : 'Indicative scope'}</h3>
                <p class="mt-2 text-sm text-muted">[PLACEHOLDER: {id ? 'detail deliverable, batas layanan, estimasi, dan dokumen yang diperlukan.' : 'deliverables, scope boundaries, estimate, and required documents.'}]</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="bg-white section-space">
        <div class="container-shell grid gap-10 lg:grid-cols-2">
          <div>
            <p class="eyebrow">{id ? 'Catatan ruang lingkup' : 'Scope note'}</p>
            <h2 class="heading mt-5">{id ? 'Setiap aktivitas memiliki jalur yang berbeda.' : 'Every activity follows a different pathway.'}</h2>
          </div>
          <div class="text-muted">
            <p>{id ? 'Nama layanan di halaman ini adalah kategori awal. Daftar layanan final, batas kewenangan, partner eksternal, dan ketentuan engagement harus dikonfirmasi sebelum launch.' : 'Service names on this page are initial categories. Final scope, authority boundaries, external partners, and engagement terms must be confirmed before launch.'}</p>
            <a class="button-primary mt-7" href={`/${locale}/contact/`}>{id ? 'Diskusikan kebutuhan' : 'Discuss your requirement'} →</a>
          </div>
        </div>
      </section>
    </>
  )}
  {page === 'projects' && (
    <section class="section-space">
      <div class="container-shell">
        <div class="grid gap-6">
          {PROJECTS[locale].map((project, index) => (
            <article class="surface grid gap-8 p-7 md:grid-cols-[8rem_1fr_.8fr] md:p-10">
              <div>
                <span class="text-xs font-bold text-gold">0{index + 1}</span>
                <p class="mt-3 text-xs uppercase tracking-wider text-muted">{project.type}</p>
              </div>
              <h2 class="font-display text-3xl">{project.title}</h2>
              <div>
                <p class="text-sm text-muted">{project.outcome}</p>
                <p class="mt-5 border-l-2 border-gold pl-3 text-xs text-muted">[PLACEHOLDER: {id ? 'hasil terverifikasi dan izin publikasi' : 'verified outcome and publication consent'}]</p>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-16 border-t border-line pt-8">
          <h2 class="font-display text-3xl">{id ? 'Logo dan testimonial klien' : 'Client logos and testimonials'}</h2>
          <p class="mt-3 text-muted">{id ? '[PLACEHOLDER: hanya ditampilkan setelah izin tertulis dan verifikasi substansi.]' : '[PLACEHOLDER: displayed only after written consent and content verification.]'}</p>
        </div>
      </div>
    </section>
  )}
  <section class="bg-gold">
    <div class="container-shell flex flex-col justify-between gap-6 py-14 md:flex-row md:items-center">
      <h2 class="font-display text-4xl">{id ? 'Butuh pemetaan untuk situasi Anda?' : 'Need a map for your situation?'}</h2>
      <a class="button-primary" href={`/${locale}/contact/`}>{id ? 'Mulai konsultasi' : 'Start a consultation'} →</a>
    </div>
  </section>
</BaseLayout>
