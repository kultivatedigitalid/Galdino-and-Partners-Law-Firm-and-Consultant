---


import { Image } from 'astro:assets';
import hansImage from '../assets/team-hans-galdino.webp';
import kelvinImage from '../assets/team-kelvin-anata-lian.webp';
import mariaImage from '../assets/team-maria-indah-putri.webp';
import michaelImage from '../assets/team-michael-alvaro.webp';
import type { ProfileMember } from '../data/profile';
import { SITE, type Locale } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from './icons/ArrowIcon.astro';


import HomeFinalCta from './home/HomeFinalCta.astro';

interface Props { locale: Locale; member: ProfileMember; alternateUrl: string; }
const { locale, member, alternateUrl } = Astro.props;
const id = locale === 'id';
const imageByKey = {
  hans: hansImage,
  kelvin: kelvinImage,
  maria: mariaImage,
  michael: michaelImage,
};
const title = `${member.name} | ${SITE.displayName}`;
const description = `${member.role}. ${member.summary}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(`/${locale}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Profile', item: new URL(`/${locale}/profile/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: member.name, item: pageUrl },
  ],
};
---

<BaseLayout immersive={false} locale={locale} title={title} description={description} alternateUrl={alternateUrl}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:member.name,jobTitle:member.role,url:pageUrl,worksFor:{'@type':'Organization',name:SITE.displayName}})}/>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="person-page editorial">

    <section class="person-hero" aria-labelledby="person-title">
      <div class="container-shell person-hero__grid">
        <div class="person-hero__copy">
          <a class="person-back" href={`/${locale}/profile/#team`}><ArrowIcon direction="left" />{id ? 'Kembali ke tim' : 'Back to team'}</a>
          <p class="person-label">{id ? 'Profil profesional' : 'Professional profile'}</p>
          <h1 id="person-title">{member.name}</h1><p class="person-summary">{member.summary}</p>
          <p class="person-role">{member.role}</p>
          <dl class="person-quickfacts" aria-label={id ? 'Kontak profesional' : 'Professional contact'}>
            <div><dt>Email</dt><dd>{member.email}</dd></div>
            <div><dt>{id ? 'Domisili' : 'Domicile'}</dt><dd>{member.domicile}</dd></div>
            <div><dt>{id ? 'Telepon' : 'Phone'}</dt><dd>{member.phone}</dd></div>
          </dl>
          <ul aria-label={id ? 'Keahlian' : 'Expertise'}>
            {member.expertise.map((item) => <li>{item}</li>)}
          </ul>
          <div class="person-contact">
            <a href={`/${locale}/contact/?person=${member.slug}`}>{id ? 'Hubungi melalui firma' : 'Contact through the firm'}<ArrowIcon /></a>
            <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Consultation — '+member.name)}`}>{SITE.email}</a>
          </div>
        </div>
        <figure class="person-hero__visual">
          <Image
            src={imageByKey[member.imageKey]}
            alt={member.imageAlt}
            widths={[540, 820, 1100]}
            sizes="(min-width: 840px) 46vw, 100vw"
            loading="eager"
            fetchpriority="high"
            quality={82}
          />
          <figcaption>{member.name}</figcaption>
        </figure>
      </div>
    </section>

    <section class="person-overview" aria-labelledby="person-overview-title">
      <div class="container-shell person-overview__grid">
        <div>
          <p class="person-label">{id ? 'Ringkasan' : 'Overview'}</p>
          <h2 id="person-overview-title">{id ? 'Fokus pendampingan' : 'Engagement focus'}</h2>
        </div>
        <div class="person-overview__body">
          <p class="person-summary">{member.summary}</p>
          <p>{member.experience}</p>
          <dl>
            <div><dt>{id ? 'Jabatan' : 'Position'}</dt><dd>{member.role}</dd></div>
            <div><dt>{id ? 'Kredensial' : 'Credentials'}</dt><dd>{member.credentials}</dd></div>
            <div><dt>{id ? 'Kontak' : 'Contact'}</dt><dd>{member.email}<br />{member.phone}<br />{member.domicile}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <div class="container-shell">
<section class="ed-section ed-columns"><div><h2>{id?'Pengalaman terpilih':'Representative matters'}</h2><ul class="ed-list">{member.matters.map(m=><li>{m}</li>)}</ul></div><div><h2>{id?'Cara bekerja':'Working approach'}</h2><p>{member.approach}</p><h3>{id?'Bahasa':'Languages'}</h3><p>{member.languages.join(' · ')}</p></div></section>
</div>
<HomeFinalCta locale={locale}/>
  </div>
</BaseLayout>

<style is:global>
  .person-page { overflow: clip; background: var(--brand-paper); color: var(--brand-black); }
  body:has(.person-page) .contact-dock__link { background: linear-gradient(120deg, #710d1b 0%, #9c1021 48%, #c4142a 100%); background-position: 0 50%; background-size: 180% 100%; box-shadow: 0 12px 34px rgb(38 3 8 / .24); opacity: 1; transition: background-position 260ms var(--brand-ease), box-shadow 200ms var(--brand-ease), transform 170ms var(--brand-ease); }
  body:has(.person-page) .contact-dock__pulse { background: #fff; box-shadow: 0 0 0 4px rgb(255 255 255 / .16); }
  .person-hero { background: #fff; }
  .person-hero__grid { min-height: clamp(40rem, 100svh, 50rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(25rem, .88fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; padding-top: 3rem; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .person-back { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; gap: .5rem; color: var(--brand-muted); font-size: .7rem; font-weight: 780; text-decoration: none; }
  .person-label { width: fit-content; margin: 1.2rem 0 0; border-bottom: 2px solid var(--brand-red); padding-bottom: .3rem; color: var(--brand-black); font-size: .68rem; font-weight: 820; letter-spacing: .05em; text-transform: uppercase; }
  .person-hero h1 { max-width: 14ch; margin: 1.15rem 0 0; font-family: var(--font-display); font-size: clamp(2.8rem, 5vw, 5.2rem); font-weight: 570; letter-spacing: -.04em; line-height: .95; overflow-wrap: anywhere; text-wrap: balance; }
  .person-role { margin: 1rem 0 0; color: var(--brand-red-deep); font-size: .88rem; font-weight: 820; }
  .person-quickfacts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 1.25rem 0 0; border-block: 1px solid var(--brand-line-strong); }
  .person-quickfacts > div { min-width: 0; padding: .8rem .7rem .8rem 0; }
  .person-quickfacts > div + div { border-left: 1px solid var(--brand-line-strong); padding-left: .7rem; }
  .person-quickfacts dt { color: var(--brand-muted); font-size: .57rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .person-quickfacts dd { margin: .42rem 0 0; color: var(--brand-black); font-size: .64rem; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
  .person-hero ul { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .person-hero li { border: 1px solid var(--brand-line-strong); background: #f1f0ed; padding: .45rem .65rem; font-size: .66rem; font-weight: 720; }
  .person-contact { display: flex; flex-wrap: wrap; gap: .8rem 1.4rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--brand-line-strong); }
  .person-contact a { min-height: 2.75rem; display: inline-flex; align-items: center; gap: .5rem; color: var(--brand-black); font-size: .72rem; font-weight: 800; text-underline-offset: .25rem; }
  .person-hero__visual { position: relative; min-height: clamp(30rem, 62vh, 41rem); margin: 0; overflow: hidden; background: var(--brand-black); }
  .person-hero__visual :where(img) { width: 100%; height: 100%; object-fit:cover; object-position: center; filter: saturate(.84) contrast(1.04) brightness(.95); }
  .person-hero__visual::after { position: absolute; right: 0; bottom: 0; left: 0; height: .35rem; background: var(--brand-red); content: ''; }
  .person-hero__visual figcaption { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; background: rgb(11 11 12 / .68); padding: .4rem .5rem; color: rgb(255 255 255 / .84); font-size: .58rem; font-weight: 760; letter-spacing: .06em; }
  .person-overview { background: var(--brand-surface-soft); padding-block: var(--brand-section-space); }
  .person-overview__grid { display: grid; grid-template-columns: minmax(15rem, .7fr) minmax(26rem, 1.3fr); gap: clamp(3rem, 8vw, 8rem); }
  .person-overview .person-label { margin-top: 0; }
  .person-overview h2 { max-width: 12ch; margin: 1.1rem 0 0; font-family: var(--font-display); font-size: var(--brand-type-section); font-weight: 570; letter-spacing: -.035em; line-height: .98; }
  .person-overview__body > p { max-width: 43rem; margin: 0; color: var(--brand-muted); font-size: .92rem; line-height: 1.7; }
  .person-overview__body > .person-summary { color: #252528; font-size: clamp(1.08rem, 1.6vw, 1.3rem); line-height: 1.55; }
  .person-overview__body > p + p { margin-top: 1rem; }
  .person-overview dl { margin: 2.25rem 0 0; border-top: 1px solid var(--brand-line-strong); }
  .person-overview dl > div { display: grid; grid-template-columns: minmax(7rem, .35fr) minmax(0, 1fr); gap: 1.25rem; padding-block: 1rem; border-bottom: 1px solid var(--brand-line-strong); }
  .person-overview dt { color: var(--brand-muted); font-size: .65rem; font-weight: 760; }
  .person-overview dd { margin: 0; color: var(--brand-black); font-size: .78rem; font-weight: 700; overflow-wrap: anywhere; }
  @media (hover: hover) and (pointer: fine) {
    body:has(.person-page) .contact-dock__link:hover { background-position: 100% 50%; box-shadow: 0 15px 42px rgb(38 3 8 / .32); opacity: 1; transform: translateY(-2px); }
    .person-contact a:hover, .person-back:hover { color: var(--brand-red); }
    .person-contact a :where(.arrow-icon) { transition: transform 170ms var(--brand-ease); }
    .person-contact a:hover :where(.arrow-icon) { transform: translateX(3px); }
  }
  @media (max-width: 840px) {
    .person-hero__grid { min-height: 0; grid-template-columns: 1fr; padding-top: 3rem; }
    .person-hero__visual { min-height: 0; aspect-ratio: 16 / 11; }
    .person-overview__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 560px) {
    .person-hero__grid { padding-top: 3rem; }
    .person-hero h1 { font-size: clamp(2.55rem, 11vw, 3.5rem); }
    .person-hero__visual { aspect-ratio: 4 / 3; }
    .person-quickfacts { grid-template-columns: 1fr; }
    .person-quickfacts > div + div { border-top: 1px solid var(--brand-line-strong); border-left: 0; padding-left: 0; }
    .person-overview dl > div { grid-template-columns: 1fr; gap: .35rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    body:has(.person-page) .contact-dock__link { transition-duration: .01ms; }
    .person-contact a :where(.arrow-icon) { transition-duration: .01ms; }
  }
</style>
<style is:global>.person-hero__grid{padding-top:clamp(2rem,4vw,3.5rem);min-height:0;padding-bottom:4rem;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)}.person-hero h1{font-size:var(--brand-type-hero);letter-spacing:-.035em;line-height:.98}.person-hero__copy>.person-summary{font-size:1rem;line-height:1.65;color:var(--brand-muted);margin-top:1.5rem}.person-hero__visual{min-height:0;aspect-ratio:4/5;max-height:33rem;width:100%;border-left:2px solid var(--brand-red);border-bottom:2px solid var(--brand-red);background:var(--brand-surface-soft)}.person-hero__visual :where(img){width:100%;height:100%;object-fit:cover;filter:none}.person-page .ed-columns h2{font-size:var(--brand-type-card)}.person-page .ed-columns h3{font-size:1.05rem;margin-top:1.5rem}.person-page .ed-columns :is(p,li){font-size:1rem;line-height:1.65}.person-overview h2{font-size:var(--brand-type-section)}@media(max-width:840px){.person-hero__grid{grid-template-columns:1fr;padding-top:2rem}.person-hero__visual{max-width:25rem;justify-self:center}.person-overview__grid{grid-template-columns:1fr}}</style>
