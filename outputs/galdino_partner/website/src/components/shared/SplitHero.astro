---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props{title:string;description:string;image:ImageMetadata;alt?:string;href:string;action:string;variant?:'service'|'industry'}
const {title,description,image,alt='',href,action,variant='service'}=Astro.props;
---
<header class:list={['split-hero','split-hero--'+variant]}><div class="container-shell split-hero__layout"><div><h1>{title}</h1><p>{description}</p><a class="ed-button" href={href}>{action} →</a></div><figure><Image src={image} alt={alt} widths={[480,800,1200]} sizes="(min-width:800px) 45vw,100vw" loading="eager" fetchpriority="high" quality={82}/></figure></div></header>
<style>
.split-hero{background:var(--brand-black);color:#fff;padding:clamp(7rem,12vw,10rem) 0 clamp(3rem,6vw,5rem)}.split-hero__layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(2rem,6vw,6rem);align-items:center}.split-hero h1{font-size:var(--brand-type-hero);font-weight:570;line-height:.98;letter-spacing:-.035em;margin:0;max-width:16ch}.split-hero p{font-size:clamp(.92rem,1.5vw,1.08rem);color:rgb(255 255 255 / .78);line-height:1.52;margin:1.5rem 0 2rem;max-width:48ch}.split-hero figure{margin:0;border-left:2px solid var(--brand-red);border-bottom:2px solid var(--brand-red);overflow:hidden}.split-hero :global(img){width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:center}.split-hero--industry{background:#171719}.split-hero--industry figure{aspect-ratio:16/11}.split-hero--industry :global(img){height:100%;aspect-ratio:16/11}@media(max-width:800px){.split-hero__layout{grid-template-columns:1fr}.split-hero{padding-top:7rem}.split-hero figure{max-width:40rem}}
</style>
