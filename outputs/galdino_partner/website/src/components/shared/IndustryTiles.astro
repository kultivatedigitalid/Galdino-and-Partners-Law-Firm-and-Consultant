---
import {Image} from 'astro:assets';
import {INDUSTRIES,industryUrl} from '../../data/industries';
import {industryImages} from '../../data/industry-images';
import type {Locale} from '../../data/site';
interface Props{locale:Locale;limit?:number}
const {locale,limit=6}=Astro.props,id=locale==='id';
---
<div class="industry-tiles">{INDUSTRIES.slice(0,limit).map(industry=><article id={'sector-'+industry.id} class="industry-tile">
<a class="tile-image" href={industryUrl(industry,locale)} tabindex="-1" aria-hidden="true"><Image src={industryImages[industry.id]} alt="" widths={[480,800,1200]} sizes="(min-width:1025px) 30vw, (min-width:601px) 45vw, 100vw" loading="lazy" quality={76}/></a>
<div class="tile-copy"><h2><a href={industryUrl(industry,locale)}>{industry.content[locale].short}</a></h2><p>{industry.content[locale].description}</p><a class="reveal-link" data-label={id?'Jelajahi industri →':'Explore industry →'} href={industryUrl(industry,locale)}>{id?'Jelajahi industri':'Explore industry'} →</a></div>
</article>)}</div>
<style>.industry-tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3rem 1.5rem}.industry-tile{min-width:0;display:flex;flex-direction:column;scroll-margin-top:7rem}.tile-image{display:block;position:relative;overflow:hidden;border-left:2px solid var(--brand-red);border-bottom:2px solid var(--brand-red);aspect-ratio:4/3}.tile-image :global(img){width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 350ms}.tile-copy{display:flex;flex-direction:column;flex:1;padding-top:1.5rem}.tile-copy .ed-link{margin-top:auto}.tile-copy h2{min-height:2.2em}.tile-copy h2{font-size:var(--brand-type-card)}.tile-copy h2 a{text-decoration:none}.tile-copy p,.tile-copy ul{font-size:.85rem;color:#56565b}.tile-copy ul{padding-left:1rem;margin:1rem 0}@media(hover:hover){.industry-tile:hover .tile-image :global(img){transform: none;}}@media(max-width:1024px){.industry-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.industry-tiles{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.tile-image :global(img){transition:none}}</style>

<style>.tile-copy p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em;line-height:1.4}.tile-copy .reveal-link{margin-top:auto}.tile-copy h2{margin-bottom:.75rem}.tile-image:hover :global(img){transform:scale(1.02)}</style>
