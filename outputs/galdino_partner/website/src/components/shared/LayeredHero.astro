---
import {Image} from 'astro:assets';
import ArrowIcon from '../icons/ArrowIcon.astro';
import HeroHighlight from './HeroHighlight.astro';
import {layeredHeroes, type LayeredHeroPage} from '../../data/layered-heroes';
import type {Locale} from '../../data/site';
interface Props {locale:Locale; page:LayeredHeroPage}
const {locale,page}=Astro.props;
const hero=layeredHeroes[page],text=hero.content[locale];
const destination=hero.destination==='contact'?'/'+locale+'/contact/':hero.destination;
const titleId=page+'-hero-title';
const visiblePhotoHeight=hero.cutout.height-hero.photoTop;
const photoStyle='--photo-scale:'+hero.cutout.height/visiblePhotoHeight+';--photo-aspect:'+hero.cutout.width+'/'+visiblePhotoHeight;
---
<section class:list={['layered-hero','layered-hero--'+page]} lang={locale} aria-labelledby={titleId} data-hero-motion="ready">
 <Image class="layered-hero__backdrop" data-hero-part="backdrop" src={hero.backdrop} alt="" aria-hidden="true" widths={[400,800,1200,1600,1784]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={85}/>
 <div class="container-shell layered-hero__inner">
  <div class="layered-hero__copy">
   <h1 id={titleId} data-hero-part="title"><HeroHighlight text={text.titleStart}/>{' '}{text.titleLines.map(line=><span class="layered-hero__title-line">{line}{' '}</span>)}</h1>
   <p class="layered-hero__lead" data-hero-part="lead">{text.lead}</p>
   <a class="ed-button layered-hero__cta" data-hero-part="action" href={destination}>{text.cta}<ArrowIcon/></a>
  </div>
 </div>
 <figure class="layered-hero__visual" style={photoStyle} data-hero-part="visual">
  <Image class="layered-hero__image" src={hero.cutout} alt={text.alt} widths={[400,640,800,960,1280,1600,1784]} sizes="(max-width:640px) calc(100vw - 24px), (max-width:1280px) 80vw, 64rem" loading="eager" fetchpriority="high" format="webp" quality={85}/>
 </figure>
</section>
<style>
.layered-hero{position:relative;isolation:isolate;display:flex;flex-direction:column;height:100svh;min-height:42rem;overflow:clip;background:var(--hero-background,var(--brand-paper));color:var(--brand-black);--hero-scene-opacity:.64}
.layered-hero :global(.layered-hero__backdrop){mix-blend-mode:multiply}
.layered-hero__visual{mix-blend-mode:normal;opacity:1}
.layered-hero--about{min-height:46rem}
.layered-hero :global(.layered-hero__backdrop){position:absolute;inset:auto 0 0;z-index:-1;width:100%;height:64%;object-fit:cover;object-position:center bottom;opacity:var(--hero-scene-opacity);mask-image:linear-gradient(transparent,#000 22%);pointer-events:none}
.layered-hero__inner{flex-shrink:0;position:relative;z-index:2;padding-top:calc(var(--site-header-height) + clamp(3.25rem,8svh,5.5rem));padding-bottom:2rem}
.layered-hero__copy{width:100%;max-width:65rem;margin-inline:auto;text-align:center}
.layered-hero h1{max-width:none;margin:0 auto;font-family:var(--font-display);font-size:var(--brand-type-hero);font-weight:570;letter-spacing:-.035em;line-height:.98;text-wrap:balance}
.layered-hero__title-line{display:block;margin-top:.2em}
.layered-hero__lead{max-width:43rem;margin:1.5rem auto 0;color:var(--brand-muted);font-size:clamp(.92rem,1.5vw,1.08rem);line-height:1.52;text-wrap:pretty}
.layered-hero__cta{margin-top:1.5rem;transition:transform 170ms var(--brand-ease),background-color 170ms var(--brand-ease)}
.layered-hero__cta :global(.arrow-icon){transition:transform 170ms var(--brand-ease)}
.layered-hero__visual{position:relative;z-index:1;width:min(80%,64rem);height:clamp(18rem,44svh,32rem);min-height:0;overflow:visible;margin:auto auto 0}
.layered-hero :global(.layered-hero__image){position:absolute;inset:auto 0 0;width:100%;height:calc(100% * var(--photo-scale));object-fit:contain;object-position:center bottom}
.layered-hero--services :global(.layered-hero__image),.layered-hero--about :global(.layered-hero__image),.layered-hero--experiences :global(.layered-hero__image),.layered-hero--industries :global(.layered-hero__image){filter:grayscale(1)}
.layered-hero :global(.layered-hero__image){mask-image:none;opacity:1}
@media(min-width:641px){
 .layered-hero--about .layered-hero__inner{padding-bottom:1rem}
 .layered-hero--about .layered-hero__visual{margin:0 auto;top:auto}
}
@media(min-width:641px) and (max-height:800px){
 .layered-hero__inner{padding-top:calc(var(--site-header-height) + 3rem);padding-bottom:1.5rem}
 .layered-hero__lead,.layered-hero__cta{margin-top:1rem}
}
@media(min-width:641px) and (max-height:640px){
 .layered-hero :global(.layered-hero__backdrop){mask-image:linear-gradient(transparent 60%,#000 90%)}
}
@media(hover:hover) and (pointer:fine){.layered-hero__cta:hover{transform:translateY(-2px)}.layered-hero__cta:hover :global(.arrow-icon){transform:translateX(3px)}}
@media(max-width:640px){
 .layered-hero{height:auto;min-height:0}
 .layered-hero__inner{padding-top:calc(var(--site-header-height) + 2.5rem)}
 .layered-hero h1{max-width:20ch;font-size:clamp(2.1rem,9.5vw,3rem)}
 .layered-hero__lead{font-size:var(--brand-type-lead);margin-top:1.25rem}
 .layered-hero .layered-hero__visual{width:calc(100% - 1.5rem);height:auto;aspect-ratio:var(--photo-aspect);margin-top:1.75rem}
 .layered-hero :global(.layered-hero__backdrop){inset:auto 0 0;height:60%;object-position:50% bottom;mask-image:linear-gradient(transparent,#000 20%)}
}
@media(prefers-reduced-motion:reduce){.layered-hero__cta,.layered-hero__cta :global(.arrow-icon){transition:none}}
/* Lift the location together with the raised About Us team image. */
.layered-hero--about :global(.layered-hero__backdrop){bottom:4rem;mask-image:linear-gradient(transparent,#000 22%,#000 85%,transparent)}
@media(min-width:641px) and (max-height:640px){.layered-hero--about :global(.layered-hero__backdrop){mask-image:linear-gradient(transparent 60%,#000 90%,transparent)}}
@media(max-width:640px){.layered-hero--about :global(.layered-hero__backdrop){bottom:2rem}}
</style>
