---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import type {Locale} from '../../data/site';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {locale:Locale;title:string;description?:string;image:ImageMetadata;mobileImage?:ImageMetadata;alt?:string;breadcrumbs:{name:string;href?:string}[]}
const {locale,title,description,image,mobileImage,alt='',breadcrumbs}=Astro.props;
---
<header class="image-hero">
  <picture class="image-hero__media">
    {mobileImage&&<source media="(max-width:640px)" srcset={mobileImage.src}/>}
  <Image src={image} alt={alt} widths={[640,960,1440,1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={80}/>
  </picture>
  <div class="container-shell image-hero__copy"><h1>{title}</h1>{description&&<p>{description}</p>}</div>
</header>
<div class="hero-breadcrumbs"><div class="container-shell"><Breadcrumbs locale={locale} items={breadcrumbs}/></div></div>
<style>
.image-hero{position:relative;isolation:isolate;display:grid;align-items:center;min-height:max(34rem,100svh);padding:6.5rem 0 2.5rem;background:var(--brand-black);color:#fff}
.image-hero__media{position:absolute;inset:0;z-index:-2;width:100%;height:100%}
.image-hero__media :global(img){width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.75)}
.image-hero::before{position:absolute;inset:0;z-index:-1;content:'';background:linear-gradient(90deg,rgba(15,8,10,.88),rgba(15,8,10,.65) 55%,rgba(15,8,10,.3)),linear-gradient(0deg,rgba(113,13,27,.3),transparent 65%)}
.image-hero__copy h1{max-width:14ch;margin:0;font-family:var(--font-display);font-size:var(--brand-type-hero);font-weight:570;letter-spacing:-.035em;line-height:.98;text-wrap:balance}
.image-hero__copy p{max-width:29rem;margin:1.5rem 0 0;color:#f3efef;font-size:var(--brand-type-lead);line-height:1.58}
.hero-breadcrumbs{border-top:4px solid var(--brand-red);background:var(--brand-paper)}
.hero-breadcrumbs :global(.ed-breadcrumb){margin:0;padding:1.25rem 0}
@media(max-width:640px){.image-hero{min-height:max(31rem,100svh);padding:6.5rem 0 2.5rem}}
</style>
