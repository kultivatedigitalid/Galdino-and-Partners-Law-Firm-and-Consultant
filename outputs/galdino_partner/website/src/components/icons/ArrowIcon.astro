---
interface Props {
  direction?: 'right' | 'left' | 'up-right';
  class?: string;
}

const { direction = 'right', class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow-icon', className]}
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {direction === 'left' && <path d="M17 10H4m5-5-5 5 5 5" />}
  {direction === 'right' && <path d="M3 10h13m-5-5 5 5-5 5" />}
  {direction === 'up-right' && <path d="M5 15 15 5M8 5h7v7" />}
</svg>

<style>
  .arrow-icon {
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
    overflow: visible;
  }
</style>
