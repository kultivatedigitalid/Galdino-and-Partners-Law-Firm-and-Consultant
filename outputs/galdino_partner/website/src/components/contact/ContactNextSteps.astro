---
import type {Locale} from '../../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id';
const steps=id?[
 ['Inquiry diterima','Kami meninjau kebutuhan Anda.'],
 ['Kami menghubungi Anda','Atur jadwal via email atau WhatsApp.'],
 ['Lengkapi konteks','Siapkan dokumen dan pertanyaan utama.'],
 ['Konsultasi awal gratis','Bahas prioritas dan kebutuhan izin.'],
 ['Perjelas ruang lingkup','Tinjau pekerjaan dan estimasi biaya.'],
 ['Sepakati langkah berikutnya','Pendampingan dimulai setelah kesepakatan.']
]:[
 ['Enquiry received','We review your requirements.'],
 ['We contact you','Arrange a discussion via email or WhatsApp.'],
 ['Complete the context','Prepare your records and main questions.'],
 ['Free initial consultation','Discuss permit priorities and requirements.'],
 ['Clarify the scope','Review the work and estimated fees.'],
 ['Agree the next step','Support begins once scope and fees are agreed.']
];
---
<section class="contact-next-steps" aria-labelledby="contact-next-title"><h2 id="contact-next-title">{id?'Apa yang Selanjutnya Terjadi?':'What Happens Next?'}</h2><ol>{steps.map(([title,description],i)=><li><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{description}</p></div></li>)}</ol></section>
<style>
.contact-next-steps{margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--brand-line-strong)}
.contact-next-steps h2{font-size:clamp(1.25rem,1.8vw,1.5rem);line-height:1.2;margin:0 0 .9rem}
.contact-next-steps ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem 1.25rem}
.contact-next-steps li{display:flex;gap:.65rem;align-items:start}
.contact-next-steps span{color:var(--brand-red);font-size:.7rem;font-weight:750;padding-top:.15rem}
.contact-next-steps h3{font-size:.85rem;letter-spacing:-.015em;line-height:1.35;margin:0 0 .15rem}
.contact-next-steps p{color:var(--brand-muted);font-size:.78rem;line-height:1.45;margin:0}
@media(max-width:420px){.contact-next-steps ol{grid-template-columns:1fr}}
</style>
