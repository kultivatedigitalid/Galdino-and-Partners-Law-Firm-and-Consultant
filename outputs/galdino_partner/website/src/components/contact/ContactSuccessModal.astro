---
import type {Locale} from '../../data/site';interface Props{locale:Locale}const {locale}=Astro.props;const id=locale==='id';
---
<dialog id="contact-success" class="contact-success" aria-labelledby="success-title" aria-describedby="success-description">
<div><p class="ed-kicker">{id?'PERMINTAAN DITERIMA':'REQUEST RECEIVED'}</p><h2 id="success-title">{id?'Terima kasih.':'Thank you.'}</h2>
<p id="success-description">{id?'Permintaan konsultasi Anda sudah kami terima. Tim Galdino & Partner akan meninjau kebutuhan yang disampaikan dan menghubungi Anda melalui email atau WhatsApp yang diberikan.':'We received your consultation request. The Galdino & Partner team will review the information provided and contact you through your email or WhatsApp details.'}</p>
<form method="dialog"><button class="ed-button" autofocus>{id?'Tutup':'Close'} →</button></form></div></dialog>
<style>.contact-success{position:fixed;inset:0;margin:auto;border:0;border-top:4px solid #bd1429;background:#fff;color:#171719;width:36rem;max-height:calc(100dvh - 2rem);overflow:auto;padding:clamp(1.4rem,4vw,3rem)}.contact-success::backdrop{background:#000a}.contact-success h2{font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-.04em;line-height:1.1;margin:1rem 0}.contact-success p{margin-bottom:1.7rem}.contact-success[open]{animation:enter 180ms ease-out}@keyframes enter{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.contact-success[open]{animation:none}}</style>
