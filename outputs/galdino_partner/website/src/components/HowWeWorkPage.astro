---
import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumbs from './shared/Breadcrumbs.astro';import ContactNextSteps from './contact/ContactNextSteps.astro';import HomeFinalCta from './home/HomeFinalCta.astro';import type {Locale} from '../data/site';
interface Props{locale:Locale}const {locale}=Astro.props,id=locale==='id';const steps=id?[
['Pahami kegiatan dan lokasi','Kami membahas tujuan, tahap proyek, penanggung jawab, dan batas waktu bisnis. Konsultasi awal gratis digunakan untuk memastikan konteks sebelum meminta dokumen rinci.'],
['Periksa dokumen dan dependensi','Arsip yang tersedia dibandingkan dengan persyaratan. Ketidaksesuaian, dokumen yang belum tersedia, serta keputusan yang menjadi prasyarat dicatat dalam daftar tindak lanjut.'],
['Sepakati scope, biaya, dan jadwal','Penawaran tertulis menjelaskan hasil kerja, pengecualian, biaya profesional, biaya pihak ketiga, dan tanggung jawab masing-masing pihak. Perubahan lingkup dikonfirmasi sebelum pekerjaan tambahan.'],
['Siapkan dan koordinasikan proses','Tim mengelola versi dokumen dan tindak lanjut, berkoordinasi dengan tenaga teknis bila diperlukan, serta mencatat status pengajuan. Keputusan izin atau sertifikasi tetap pada pihak berwenang.'],
['Serahkan arsip dan kewajiban berikutnya','Anda menerima dokumen sesuai scope, ringkasan status, daftar hal yang masih terbuka, dan kewajiban lanjutan. Jadwal pelaporan atau pembaruan dicatat agar dapat dikelola oleh tim Anda.']
]:[
['Understand the activity and location','We discuss objectives, project stage, responsible people and business deadlines. A free initial consultation establishes context before detailed documents are requested.'],
['Review documents and dependencies','Available records are compared with requirements. Discrepancies, missing documents and prerequisite decisions are recorded in a follow-up list.'],
['Agree scope, fees and timing','A written quotation states deliverables, exclusions, professional fees, third-party costs and each party’s responsibilities. Scope changes are confirmed before additional work.'],
['Prepare and coordinate the process','The team manages document versions and follow-up, coordinates technical specialists where needed and records submission status. Authorities and independent bodies retain approval decisions.'],
['Hand over records and next obligations','You receive scoped documents, a status summary, open issues and continuing obligations. Reporting or renewal dates are recorded for your team to manage.']
];
---
<BaseLayout locale={locale} title={(id?'Cara Kerja':'How We Work')+' | Galdino & Partner'} description={id?'Dari konsultasi awal gratis hingga serah terima dokumen: proses kerja, pembagian tanggung jawab, scope, biaya, dan tindak lanjut yang jelas.':'From a free first consultation to document handover: a clear process, responsibilities, scope, fees and follow-up.'}><div class="editorial"><header class="ed-hero"><div class="container-shell"><Breadcrumbs locale={locale} items={[{name:id?'Tentang Kami':'About Us',href:`/${locale}/profile/`},{name:id?'Cara Kerja':'How We Work'}]}/><p class="ed-kicker">{id?'Cara kerja':'How we work'}</p><h1>{id?'Langkah jelas. Tanggung jawab terukur.':'Clear steps. Defined responsibilities.'}</h1><p class="ed-lead">{id?'Kami memisahkan apa yang perlu diputuskan, apa yang perlu disiapkan, dan siapa yang bertanggung jawab agar proses mudah diikuti.':'We identify the decisions, preparation and responsible people so the process remains easy to follow.'}</p></div></header><div class="container-shell">{steps.map(([title,body],i)=><section class="ed-section ed-split"><div><p class="ed-kicker">0{i+1}</p><h2>{title}</h2></div><p class="ed-lead">{body}</p></section>)}<ContactNextSteps locale={locale}/></div><HomeFinalCta locale={locale}/></div></BaseLayout>