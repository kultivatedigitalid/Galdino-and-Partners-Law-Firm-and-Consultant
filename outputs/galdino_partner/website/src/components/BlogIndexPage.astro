---
import {Image} from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LayeredHero from './shared/LayeredHero.astro';
import InsightCard from './blog/InsightCard.astro';
import {blogImage} from '../data/blog-images';
import {getPublishedPosts,postUrl} from '../utils/blog';
import type {Locale} from '../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id';
const posts=await getPublishedPosts(locale),featured=posts[0];
const categories=[...new Set(posts.map(p=>p.data.category))],tags=[...new Set(posts.flatMap(p=>p.data.tags))];
const date=(d:Date)=>new Intl.DateTimeFormat(id?'id-ID':'en-GB',{dateStyle:'medium'}).format(d);
---
<BaseLayout immersive={false} overlayHeader locale={locale} title={id?'Insight Perizinan & Kepatuhan | Galdino & Partner':'Licensing & Compliance Insights | Galdino & Partner'} description={id?'Panduan praktis seputar bangunan, tata ruang, lingkungan, dan kepatuhan usaha. Temukan artikel berdasarkan topik dan kebutuhan Anda.':'Practical guidance on buildings, spatial planning, environment and business compliance. Explore articles by topic and requirement.'}>
 <div class="editorial blog-index">
  <LayeredHero locale={locale} page="insights"/>
  <div class="container-shell blog-content">
   <nav class="blog-topics" aria-label={id?'Topik Insight':'Insight topics'}><a href="#latest-insights" data-topic="" aria-current="true">{id?'Semua artikel':'All articles'}</a>{categories.map((category,index)=><a href={'#insight-topic-'+index} data-topic={category}>{category}</a>)}</nav>
   {featured&&<section class="featured-insight" aria-labelledby="featured-title">
    <a class="featured-insight__photo" href={postUrl(featured)} tabindex="-1" aria-hidden="true"><Image src={blogImage(featured)} alt="" widths={[640,960,1280]} sizes="(min-width:801px) 50vw,100vw" loading="lazy" quality={85}/></a>
    <div class="featured-insight__copy"><p class="featured-insight__label">{id?'Artikel pilihan':'Featured story'}</p><h2 id="featured-title"><a href={postUrl(featured)}>{featured.data.title}</a></h2><p class="featured-insight__summary">{featured.data.description}</p><p class="featured-insight__meta"><span>{featured.data.author}</span><time datetime={featured.data.publishDate.toISOString()}>{date(featured.data.publishDate)}</time></p><a class="ed-link" href={postUrl(featured)}>{id?'Baca artikel':'Read article'} →</a></div>
   </section>}
   <section id="latest-insights" class="blog-library" aria-labelledby="insight-library-title">
    <header class="blog-library__heading"><h2 id="insight-library-title">{id?'Temukan Insight Anda.':'Find your next insight.'}</h2><p id="insight-count" class="ed-results" role="status" aria-live="polite">{posts.length} {id?'artikel':'articles'}</p></header>
    <div class="insight-filters">
     <div class="ed-search"><label for="insight-search">{id?'Cari artikel':'Search articles'}</label><input id="insight-search" type="search" placeholder={id?'Topik atau kata kunci':'Topic or keyword'} aria-controls="insight-list"/></div>
     <div class="ed-search"><label for="insight-category">{id?'Kategori':'Category'}</label><select id="insight-category"><option value="">{id?'Semua kategori':'All categories'}</option>{categories.map(c=><option value={c}>{c}</option>)}</select></div>
     <div class="ed-search"><label for="insight-tag">Tag</label><select id="insight-tag"><option value="">{id?'Semua tag':'All tags'}</option>{tags.map(t=><option value={t}>{t}</option>)}</select></div>
    </div>
    <div id="insight-list">{categories.map((category,index)=><section class="insight-topic" id={'insight-topic-'+index} data-insight-group aria-labelledby={'insight-topic-title-'+index}><h2 id={'insight-topic-title-'+index}>{category}</h2><div class="insight-grid">{posts.filter(p=>p.data.category===category).map(post=><InsightCard post={post} filterable/>)}</div></section>)}</div>
    <div id="insight-empty" class="ed-empty" hidden><h3>{id?'Belum menemukan artikel yang sesuai.':'No matching articles.'}</h3><p>{id?'Coba kata lain atau hapus filter.':'Try another term or clear the filters.'}</p><button type="button" class="ed-button secondary" id="insight-reset">{id?'Reset pencarian':'Reset search'}</button></div>
   </section>
  </div>
 </div>
</BaseLayout>
<style>
 .blog-index{background:var(--brand-paper);--hero-background:var(--brand-paper)}.blog-content{padding-bottom:clamp(4.5rem,7vw,7rem)}
 .blog-topics{display:flex;flex-wrap:wrap;gap:.5rem 2rem;align-items:center;padding-block:1.25rem;border-bottom:1px solid var(--brand-line);scroll-margin-top:var(--site-header-height)}
 .blog-topics a{padding:.75rem 0;color:var(--brand-muted);font-size:.85rem;font-weight:750;text-decoration:none;border-bottom:2px solid transparent}.blog-topics a[aria-current="true"]{color:var(--brand-black);border-color:var(--brand-red)}
 .featured-insight{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,4vw,4rem);align-items:center;padding-block:clamp(3rem,5vw,5rem)}
 .featured-insight__photo{display:block;aspect-ratio:16/10;overflow:hidden;border-radius:var(--brand-cta-radius)}.featured-insight__photo :global(img){width:100%;height:100%;object-fit:cover}
 .featured-insight__label{margin:0 0 1rem;color:var(--brand-muted);font-size:.8rem;font-weight:700}.featured-insight h2{margin:0;font-size:clamp(1.75rem,2.5vw,2.6rem);line-height:1.2;letter-spacing:-.025em}.featured-insight h2 a{text-decoration:none}
 .featured-insight__summary{margin:1.5rem 0;color:var(--brand-muted);font-size:1rem;line-height:1.65}.featured-insight__meta{display:grid;gap:.4rem;margin:1.5rem 0 1rem;font-size:.8rem;color:var(--brand-muted)}.featured-insight__meta span{color:var(--brand-black);font-weight:700}
 .blog-library{scroll-margin-top:calc(var(--site-header-height) + 1rem)}.blog-library__heading{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:2rem}.blog-library__heading h2{margin:0;font-size:clamp(1.75rem,3vw,2.5rem)}
 .insight-filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:1rem}.insight-topic{padding-top:clamp(3rem,5vw,5rem);scroll-margin-top:calc(var(--site-header-height) + 1.5rem)}.insight-topic h2{margin:0 0 2rem;font-size:clamp(2rem,3.5vw,3rem)}.insight-topic[hidden]{display:none}
 .insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3rem 1.5rem}
 @media(max-width:1024px){.insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:800px){.featured-insight{grid-template-columns:1fr}.insight-filters{grid-template-columns:1fr}.blog-topics{gap:.25rem 1.25rem}.featured-insight__photo{aspect-ratio:16/9}}
 @media(max-width:600px){.insight-grid{grid-template-columns:1fr}.blog-library__heading{align-items:flex-start}}
</style>
<script>
 const search=document.querySelector<HTMLInputElement>('#insight-search'),category=document.querySelector<HTMLSelectElement>('#insight-category'),tag=document.querySelector<HTMLSelectElement>('#insight-tag'),rows=[...document.querySelectorAll<HTMLElement>('[data-insight]')],topics=[...document.querySelectorAll<HTMLAnchorElement>('[data-topic]')];
 const norm=(s:string)=>s.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 const update=()=>{const terms=norm(search?.value||'').trim().split(/\s+/).filter(Boolean);let n=0;rows.forEach(row=>{const tags=JSON.parse(row.dataset.tags||'[]') as string[];row.hidden=!terms.every(term=>norm(row.dataset.search||'').includes(term))||!!category?.value&&row.dataset.category!==category.value||!!tag?.value&&!tags.includes(tag.value);if(!row.hidden)n++;});document.querySelectorAll<HTMLElement>('[data-insight-group]').forEach(group=>{group.hidden=![...group.querySelectorAll<HTMLElement>('[data-insight]')].some(row=>!row.hidden);});topics.forEach(topic=>{if(topic.dataset.topic===(category?.value||''))topic.setAttribute('aria-current','true');else topic.removeAttribute('aria-current');});const count=document.querySelector('#insight-count'),empty=document.querySelector<HTMLElement>('#insight-empty');if(count)count.textContent=n+' / '+rows.length+' '+(document.documentElement.lang==='id'?'artikel':'articles');if(empty)empty.hidden=n!==0;};
 search?.addEventListener('input',update);category?.addEventListener('change',update);tag?.addEventListener('change',update);
 topics.forEach(topic=>topic.addEventListener('click',event=>{event.preventDefault();if(category)category.value=topic.dataset.topic||'';update();document.querySelector('#latest-insights')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}));
 document.querySelector('#insight-reset')?.addEventListener('click',()=>{if(search)search.value='';if(category)category.value='';if(tag)tag.value='';update();search?.focus();});
</script>
