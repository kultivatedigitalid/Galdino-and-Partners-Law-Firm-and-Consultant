---
import { COPY, NAV, SITE, type Locale } from '../data/site';
import { alternatePath } from '../utils/i18n';
import ServiceMegaMenu from './services/ServiceMegaMenu.astro';
import ArrowIcon from './icons/ArrowIcon.astro';

interface Props { locale: Locale; immersive?: boolean; alternateUrl?: string; }
const { locale, alternateUrl, immersive } = Astro.props;
const pathname = Astro.url.pathname;
const other = locale === 'id' ? 'en' : 'id';
const languageHref = alternateUrl || alternatePath(pathname, locale);
const localeRoot = `/${locale}/`;
const isHome = pathname === localeRoot;
const usesRedBrand = isHome || pathname.startsWith(`/${locale}/profile/`);
const usesImmersiveHeader = immersive ?? usesRedBrand;
const logoSrc = '/assets/gp-logo-small.webp';
const isCurrent = (href: string) => href === localeRoot
  ? pathname === localeRoot
  : pathname === href || pathname.startsWith(href);
---

<span class="header-sentinel" data-header-sentinel aria-hidden="true"></span>
<header
  class:list={['site-header', usesImmersiveHeader && 'site-header--immersive', isHome && !usesImmersiveHeader && 'site-header--home']}
  data-scrolled="false"
>
  <a class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:bg-white focus:p-3" href="#main-content">{COPY[locale].skip}</a>
  <div class="container-shell header-inner">
    <a class="brand" href={localeRoot} aria-label={`${SITE.displayName}, ${locale === 'id' ? 'beranda' : 'home'}`}>
      <span class="brand-mark-frame" aria-hidden="true">
        <img class="brand-mark" src={logoSrc} width="240" height="165" alt="" />
      </span>
      <span class="brand-name">{SITE.displayName}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">{locale === 'id' ? 'Buka menu' : 'Open menu'}</span>
      <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav id="primary-nav" class="nav-panel" aria-label={locale === 'id' ? 'Navigasi utama' : 'Primary navigation'}>
      <div class="nav-inner">
        <div class="nav-menu">
        {NAV[locale].map((item) => item.href === '/'+locale+'/services/' ? (
          <details class="services-nav"><summary class:list={['nav-link',isCurrent(item.href)&&'active']} aria-controls="service-mega">{item.label}<svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></summary><ServiceMegaMenu locale={locale}/></details>
        ) : (
          <a class:list={['nav-link', isCurrent(item.href) && 'active']} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        </div>
        <div class="nav-actions">
        <a
          class="language-link"
          href={languageHref}
          hreflang={other}
          lang={other}
          data-preserve-scroll="true"
          aria-label={locale === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia'}
        >
          {other.toUpperCase()}
        </a>
        <a class="nav-cta" href={`/${locale}/contact/`}>{locale==='id'?'Konsultasi':'Consultation'}<ArrowIcon /></a>
        </div>
      </div>
    </nav>
  </div>
</header>
<div class="nav-backdrop" data-open="false" aria-hidden="true"></div>

<style>
  .services-nav:not([open]) > :global(.service-mega){display:none}
  .services-nav summary{display:flex;align-items:center;gap:.35rem;list-style:none;cursor:pointer;min-height:2.75rem}.services-nav summary::-webkit-details-marker{display:none}.nav-chevron{flex:0 0 auto;transition:transform 160ms var(--brand-ease)}.services-nav[open] .nav-chevron{transform:rotate(180deg)}
  .nav-backdrop{position:fixed;inset:0;z-index:39;background:rgb(11 11 12 / .25);backdrop-filter:blur(7px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity 160ms var(--brand-ease),visibility 160ms}
  .nav-backdrop[data-open="true"]{opacity:1;visibility:visible;pointer-events:auto}
  .header-sentinel { position: absolute; top: 2rem; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-header);
    isolation: isolate;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition: background-color 210ms cubic-bezier(.22, 1, .36, 1), border-color 210ms cubic-bezier(.22, 1, .36, 1);
  }
  .site-header--home { position: fixed; right: 0; left: 0; }
  .site-header--immersive { position: fixed; right: 0; left: 0; }
  .site-header[data-scrolled='true'] { background: #fff; border-bottom-color: rgb(11 11 12 / .14); }
  .header-inner { display: grid; grid-template-columns: 14rem minmax(0,1fr); min-height: var(--site-header-height); align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; min-height: 2.75rem; flex: 0 0 auto; align-items: center; gap: .65rem; color: #0b0b0c; text-decoration: none; transition: color 210ms cubic-bezier(.22, 1, .36, 1); }
  .brand-mark-frame { width: 3.6rem; height: 2.55rem; display: grid; flex: 0 0 auto; place-items: center; }
  .brand-mark { width: 100%; height: auto; object-fit: contain; filter: drop-shadow(0 1px 1px rgb(255 255 255 / .28)); }
  .site-header--immersive:not([data-scrolled='true']) .brand-mark { filter: drop-shadow(0 1px 1px rgb(255 255 255 / .45)) drop-shadow(0 3px 7px rgb(0 0 0 / .28)); }
  .brand-name { font-family: var(--font-display); font-size: 1.03rem; font-weight: 690; letter-spacing: -.025em; white-space: nowrap; }
  .nav-inner { display: grid; grid-template-columns: minmax(0,1fr) 14rem; align-items: center; gap: 1.5rem; }
  .nav-menu { display: flex; align-items: center; justify-content: center; gap: clamp(.65rem,1.2vw,1.1rem); }
  .nav-actions { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; }
  .nav-link { position: relative; padding: .75rem 0; color: #66666a; font-size: .78rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .nav-link::after { position: absolute; right: 0; bottom: .42rem; left: 0; height: 2px; background: #c4142a; content: ''; transform: scaleX(0); transform-origin: right; transition: transform 180ms cubic-bezier(.22, 1, .36, 1); }
  .nav-link.active { color: #0b0b0c; }
  .nav-link.active::after { transform: scaleX(1); transform-origin: left; }
  .language-link { min-width: 2.75rem; min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; border-left: 1px solid #deddda; padding-left: .9rem; color: #66666a; font-size: .68rem; font-weight: 850; letter-spacing: .1em; text-decoration: none; }
  .nav-cta { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: .55rem; padding: .62rem .95rem; background: #c4142a; color: #fff; font-size: .72rem; font-weight: 800; line-height: 1.2; text-align: center; text-decoration: none; transition: background-color 170ms cubic-bezier(.22, 1, .36, 1), transform 170ms cubic-bezier(.22, 1, .36, 1); white-space: nowrap; }
  .nav-cta :global(.arrow-icon) { transition: transform 170ms cubic-bezier(.22, 1, .36, 1); }
  .nav-cta:active { transform: scale(.97); }
  .menu-toggle { display: none; width: 2.85rem; height: 2.85rem; place-items: center; border: 1px solid #b9b8b5; border-radius: 50%; background: transparent; color: #0b0b0c; }
  .menu-lines { display: grid; gap: 5px; }
  .menu-lines i { display: block; width: 1rem; height: 1px; background: currentColor; transition: transform 170ms cubic-bezier(.22, 1, .36, 1); }
  .site-header--immersive:not([data-scrolled='true']) .brand,
  .site-header--immersive:not([data-scrolled='true']) .nav-link.active { color: #fff; }
  .site-header--immersive:not([data-scrolled='true']) .nav-link,
  .site-header--immersive:not([data-scrolled='true']) .language-link { color: rgb(255 255 255 / .8); }
  .site-header--immersive:not([data-scrolled='true']) .language-link { border-left-color: rgb(255 255 255 / .28); }
  .site-header--immersive:not([data-scrolled='true']) .menu-toggle { border-color: rgb(255 255 255 / .46); color: #fff; }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover::after { transform: scaleX(1); transform-origin: left; }
    .language-link:hover { color: #c4142a; }
    .nav-cta:hover { background: #0b0b0c; transform: translateY(-2px); }
    .nav-cta:hover :global(.arrow-icon) { transform: translateX(3px); }
  }
  @media (max-width: 1024px) {
    .header-inner { display: flex; min-height: var(--site-header-height); justify-content: space-between; }
    .brand-mark-frame { width: 3.2rem; height: 2.25rem; }
    .brand-name { display: inline; max-width: 10rem; overflow: hidden; text-overflow: ellipsis; }
    .menu-toggle { display: grid; flex: 0 0 auto; }
    .nav-panel { max-height:calc(100svh - 4.5rem);overflow-y:auto;overscroll-behavior:contain;position: absolute; top: calc(100% + 1px); right: 0; left: 0; z-index: var(--layer-menu); visibility: hidden; border-bottom: 1px solid #deddda; background: #fff; opacity: 0; transform: translateY(-8px); pointer-events: none; transition: opacity 170ms cubic-bezier(.22, 1, .36, 1), transform 170ms cubic-bezier(.22, 1, .36, 1), visibility 170ms; }
    .nav-panel.open { visibility: visible; opacity: 1; transform: none; pointer-events: auto; }
    .nav-inner { width: min(100% - 1.25rem, 78rem); margin-inline: auto; display: grid; grid-template-columns: 1fr; gap: 0; padding-block: .75rem 1.1rem; }
    .nav-menu, .nav-actions { display: grid; gap: 0; justify-content: stretch; }
    .nav-link { min-height: 2.75rem; display: flex; align-items: center; border-bottom: 1px solid #deddda; padding: .8rem .15rem; font-size: .9rem; }
    .nav-link::after { display: none; }
    .nav-link.active { border-bottom-color: #c4142a; color: #c4142a; }
    .language-link { width: fit-content; min-height: 2.75rem; margin-top: .8rem; border: 0; padding: .45rem .15rem; }
    .nav-cta { width: 100%; margin-top: .7rem; }
    .site-header--immersive:not([data-scrolled='true']) .nav-panel .nav-link { color: #66666a; }
    .site-header--immersive:not([data-scrolled='true']) .nav-panel .nav-link.active { color: #c4142a; }
    .site-header--immersive:not([data-scrolled='true']) .nav-panel .language-link { color: #66666a; }
    .menu-toggle[aria-expanded='true'] .menu-lines i:first-child { transform: translateY(3px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .menu-lines i:last-child { transform: translateY(-3px) rotate(-45deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-backdrop,
    .nav-chevron,
    .site-header,
    .brand,
    .nav-link::after,
    .nav-cta,
    .nav-cta :global(.arrow-icon),
    .menu-lines i,
    .nav-panel { transition-duration: .01ms; }
  }
</style>

<script>
  const scrollHeader = document.querySelector<HTMLElement>('.site-header');
  const headerSentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
  if (scrollHeader && headerSentinel && 'IntersectionObserver' in window) {
    const headerObserver = new IntersectionObserver(([entry]) => {
      scrollHeader.dataset.scrolled = String(!entry.isIntersecting);
    }, { threshold: 0 });
    headerObserver.observe(headerSentinel);
  }

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.nav-panel');
  const servicesNav=document.querySelector<HTMLDetailsElement>('.services-nav');
  const servicesSummary=servicesNav?.querySelector<HTMLElement>('summary');
  const servicePanel=servicesNav?.querySelector<HTMLElement>('.service-mega');
  const backdrop=document.querySelector<HTMLElement>('.nav-backdrop');
  let menuAnimation: Animation | undefined;
  let servicesOpen=false;
  const setServicesOpen=(open:boolean)=>{
    if(!servicesNav || !servicePanel)return;
    servicesOpen=open;
    menuAnimation?.cancel();
    if(open)servicesNav.open=true;
    if(backdrop)backdrop.dataset.open=String(open);
    const finish=()=>{servicesNav.open=open;};
    if(matchMedia('(prefers-reduced-motion: reduce)').matches){finish();return;}
    const frames=[{opacity:0,translate:'0 -6px'},{opacity:1,translate:'0 0'}];
    menuAnimation=servicePanel.animate(open?frames:[...frames].reverse(),{duration:160,easing:'cubic-bezier(.22,1,.36,1)'});
    menuAnimation.onfinish=finish;
  };
  servicesSummary?.addEventListener('click',event=>{event.preventDefault();setServicesOpen(!servicesOpen);});
  const closeMenu = () => {
    setServicesOpen(false);
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('open');
  };
  toggle?.addEventListener('click', () => {
    const next = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(next));
    nav?.classList.toggle('open', next);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if(event.key==='Escape' && servicesOpen){setServicesOpen(false);servicesSummary?.focus();return;}
    if (event.key === 'Escape' && nav?.classList.contains('open')) {
      closeMenu();
      toggle?.focus();
    }
  });

  document.addEventListener('click',event=>{if(servicesOpen && !servicesNav?.contains(event.target as Node))setServicesOpen(false);});
  document.addEventListener('focusin',event=>{if(servicesOpen && !servicesNav?.contains(event.target as Node))setServicesOpen(false);});
  matchMedia('(max-width:1024px)').addEventListener('change',closeMenu);

  const scrollKey = 'gp-language-scroll';
  const languageLink = document.querySelector<HTMLAnchorElement>('.language-link[data-preserve-scroll]');
  languageLink?.addEventListener('click', () => {
    try {
      const target = new URL(languageLink.href, window.location.href);
      sessionStorage.setItem(scrollKey, JSON.stringify({ path: target.pathname, y: window.scrollY, savedAt: Date.now() }));
    } catch {
      sessionStorage.removeItem(scrollKey);
    }
  });

  try {
    const raw = sessionStorage.getItem(scrollKey);
    if (raw) {
      const saved = JSON.parse(raw) as { path?: string; y?: number; savedAt?: number };
      const valid = saved.path === window.location.pathname && typeof saved.y === 'number' && typeof saved.savedAt === 'number' && Date.now() - saved.savedAt < 15000;
      sessionStorage.removeItem(scrollKey);
      if (valid) {
        history.scrollRestoration = 'manual';
        const restore = () => {
          const root = document.documentElement;
          const previousBehavior = root.style.scrollBehavior;
          const maxScroll = Math.max(0, root.scrollHeight - window.innerHeight);
          root.style.scrollBehavior = 'auto';
          window.scrollTo({ top: Math.min(saved.y ?? 0, maxScroll), left: 0, behavior: 'auto' });
          root.style.scrollBehavior = previousBehavior;
        };
        requestAnimationFrame(() => requestAnimationFrame(restore));
        window.addEventListener('load', restore, { once: true });
      }
    }
  } catch {
    sessionStorage.removeItem(scrollKey);
  }
</script>
