---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitHero from './shared/SplitHero.astro';
import ContextSection from './shared/ContextSection.astro';
import PermitPathway from './shared/PermitPathway.astro';
import HomeFinalCta from './home/HomeFinalCta.astro';
import {industryUrl,type Industry} from '../data/industries';
import {industryImages} from '../data/industry-images';
import {SERVICES,serviceUrl} from '../data/services';

import type {Locale} from '../data/site';
interface Props{locale:Locale;industry:Industry}
const {locale,industry:i}=Astro.props,id=locale==='id',c=i.content[locale],services=SERVICES.filter(s=>i.services.includes(s.id));
---
<BaseLayout immersive={false} locale={locale} title={c.title+' | Galdino & Partner'} description={c.description} alternateUrl={industryUrl(i,id?'en':'id')}>
<div class="editorial"><SplitHero variant="industry" title={c.title} description={c.description} image={industryImages[i.id]} href="#industry-services" action={id?'Lihat layanan terkait':'View relevant services'}/>
<div class="container-shell">
<ContextSection locale={locale} title={id?'Cakupan industri dan kebutuhan izin.':'Industry scope and permit requirements.'} intro={c.description+' '+(id?'Kami meninjau ':'We review ')+c.issues.join('; ')+'.'} detail={(id?'Mulai dengan ':'Start with ')+c.documents.join(', ')+'. '+(id?'Layanan yang dipetakan meliputi ':'The mapped services include ')+services.map(s=>s.content[locale].title).join(', ')+'.'}/></div>
<section class="dark-map"><div class="container-shell"><p class="ed-kicker">{id?'Peta kebutuhan':'Requirement map'}</p><h2>{id?'Prioritas Izin untuk Operasional Anda.':'Approval Priorities for Your Operations.'}</h2><p class="map-lead">{id?'Kami menghubungkan rencana usaha dengan persyaratan yang perlu disiapkan sebelum pengajuan. Asesmen menentukan izin yang relevan dan urutan pengerjaannya.':'We connect your business plans to the requirements to prepare before submission. The assessment identifies relevant approvals and their sequence.'}</p><PermitPathway locale={locale} landscape dark customSteps={[{title:id?'Konteks usaha':'Business context',description:c.issues.join('; ')+'.'},{title:id?'Data awal':'Initial records',description:c.documents.join(', ')+'.'},{title:id?'Kebutuhan izin':'Approval requirements',description:services.slice(0,3).map(s=>s.content[locale].title).join(', ')+'.'},{title:id?'Rencana pengajuan':'Submission plan',description:id?'Tentukan dokumen, tenaga teknis, dan persetujuan yang perlu selesai lebih dahulu.':'Identify the records, technical specialists and approvals that must be ready first.'}]}/></div></section><div class="container-shell">
<section class="ed-section" id="industry-services"><p class="ed-kicker">{id?'Layanan terkait':'Relevant services'}</p><h2>{id?'Hubungkan kebutuhan Anda.':'Connect your requirements.'}</h2><div class="ed-related">{services.map(s=><article><h3><a href={serviceUrl(s,locale)}>{s.content[locale].title}</a></h3><p>{s.content[locale].description}</p></article>)}</div><p class="ed-note">{id?'Daftar ini memulai asesmen; tidak semua layanan wajib untuk setiap usaha. Izin operasional sektoral dan persyaratan lain diperiksa sesuai kegiatan, skala, dan lokasi.':'This list starts the assessment; not every service is mandatory for every business. Sector operating approvals and other requirements are reviewed against activity, scale and location.'}</p></section>



</div><HomeFinalCta locale={locale}/></div></BaseLayout>
