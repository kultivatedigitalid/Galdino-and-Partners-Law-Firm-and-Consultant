---
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageHero from '../shared/ImageHero.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import PermitProcess from '../home/PermitProcess.astro';
import {EXPERIENCES,experienceUrl} from '../../data/experiences';
import {experienceImages} from '../../data/experience-images';
import {heroImages} from '../../data/hero-images';
import {SERVICE_CATEGORIES} from '../../data/service-catalog';
import {serviceById,serviceUrl} from '../../data/services';
import type {Locale} from '../../data/site';
interface Props{locale:Locale}const {locale}=Astro.props,id=locale==='id';
const industries=[...new Set(EXPERIENCES.map(e=>e.content[locale].industry))],stages=[...new Set(EXPERIENCES.map(e=>e.content[locale].stage))];
---
<BaseLayout immersive locale={locale} title="Our Experiences | Galdino & Partner" description={id?'Telusuri konteks, pendekatan, dan hasil pendampingan perizinan lintas industri.':'Explore the context, approach and outcomes of licensing engagements across industries.'}>
<div class="editorial evidence-journal">
<ImageHero locale={locale} kicker="Our Experiences" consultation title={id?'Pendampingan untuk Kebutuhan Bisnis Anda':'Support for Your Business Needs'} description={id?'Konteks, proses, dan hasil kerja.':'Context, process and deliverables.'} image={heroImages.experiences} mobileImage={heroImages.experiencesMobile} breadcrumbs={[{name:id?'Our Experiences':'Our Experiences'}]}/><div class="container-shell">
<form class="case-filters" aria-label={id?'Filter Our Experiences':'Experience filters'}>
<label>{id?'Industri':'Industry'}<select id="case-industry"><option value="">{id?'Semua industri':'All industries'}</option>{industries.map(x=><option value={x}>{x}</option>)}</select></label>
<label>{id?'Bidang layanan':'Practice area'}<select id="case-service"><option value="">{id?'Semua bidang':'All practice areas'}</option>{SERVICE_CATEGORIES.filter(cat=>EXPERIENCES.some(e=>e.services.some(s=>serviceById(s)?.category===cat.id))).map(cat=><option value={cat.id}>{cat.content[locale].title}</option>)}</select></label>
<label>{id?'Kebutuhan bisnis':'Business requirement'}<select id="case-stage"><option value="">{id?'Semua kebutuhan':'All requirements'}</option>{stages.map(x=><option value={x}>{x}</option>)}</select></label>
<button type="reset">{id?'Reset filter':'Reset filters'}</button></form>
<p id="case-count" class="ed-results" role="status" aria-live="polite">6 {id?'pengalaman':'experiences'}</p>
<div class="case-grid">{EXPERIENCES.map((e,n)=><article class:list={['case-entry',{featured:n===0}]} data-case data-industry={e.content[locale].industry} data-categories={e.services.map(s=>serviceById(s)?.category).join(' ')} data-stage={e.content[locale].stage}>
<a class="case-photo" href={experienceUrl(e,locale)} tabindex="-1" aria-hidden="true"><Image src={experienceImages[e.imageKey]} alt="" widths={[480,800,1200]} sizes="(min-width:1025px) 30vw, (min-width:601px) 45vw, 100vw" loading="lazy" quality={78}/><span>0{n+1} / {e.year}</span></a>
<div class="case-copy"><p class="ed-kicker">{e.content[locale].industry}</p><h2><a href={experienceUrl(e,locale)}>{e.content[locale].title}</a></h2><p class="case-company">{e.company}</p><p class="case-outcome">{e.content[locale].outcome}</p><dl><div><dt>{id?'Lokasi':'Location'}</dt><dd>{e.location}</dd></div><div><dt>{id?'Durasi':'Duration'}</dt><dd>{e.content[locale].duration}</dd></div></dl><ul class="ed-tags">{e.services.slice(0,2).map(key=>{const s=serviceById(key)!;return <li><a href={serviceUrl(s,locale)}>{s.content[locale].title}</a></li>})}</ul><a class="ed-link" href={experienceUrl(e,locale)}>{id?'Lihat pengalaman':'Explore experience'} →</a></div>
</article>)}</div><div class="ed-empty" id="case-empty" hidden><h2>{id?'Belum ada kombinasi yang sesuai.':'No matching combination.'}</h2><p>{id?'Ubah salah satu filter atau reset untuk melihat semua pengalaman.':'Change a filter or reset to see all experiences.'}</p></div>


</div><PermitProcess locale={locale} kicker={id?"Pendekatan bersama":"A shared approach"} title={id?"Konteks berbeda. Ketelitian yang sama.":"Different contexts. The same care."}/><HomeFinalCta locale={locale}/></div></BaseLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('.case-filters'),entries=[...document.querySelectorAll<HTMLElement>('[data-case]')];
 const industry=document.querySelector<HTMLSelectElement>('#case-industry'),service=document.querySelector<HTMLSelectElement>('#case-service'),stage=document.querySelector<HTMLSelectElement>('#case-stage');
 function filterCases(){let count=0;entries.forEach(e=>{e.hidden=Boolean((industry?.value&&e.dataset.industry!==industry.value)||(service?.value&&!e.dataset.categories?.split(' ').includes(service.value))||(stage?.value&&e.dataset.stage!==stage.value));if(!e.hidden)count++;});const status=document.querySelector('#case-count');if(status)status.textContent=count+' '+(document.documentElement.lang==='id'?'pengalaman':'experiences');const empty=document.querySelector<HTMLElement>('#case-empty');if(empty)empty.hidden=count>0;}
 form?.addEventListener('submit',e=>e.preventDefault());form?.addEventListener('change',filterCases);form?.addEventListener('reset',()=>setTimeout(filterCases,0));
</script>

<style>
.case-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:1rem;align-items:end;border-block:1px solid var(--brand-line-strong);padding:1.2rem 0;margin-top:var(--brand-section-space)}
.case-filters label{display:grid;gap:.5rem;font-size:.75rem;font-weight:700}
.case-filters select{width:100%;min-width:0;background:transparent;border:1px solid var(--brand-line-strong);padding:.7rem;min-height:2.75rem;border-radius:0;font-size:.85rem;color:var(--brand-black)}
.case-filters button{min-height:2.75rem;padding:.7rem 1rem;border:0;background:var(--brand-red);color:white;font-size:.8rem;cursor:pointer}
.case-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3rem 1.5rem;margin:1.5rem 0 var(--brand-section-space)}
.case-entry{min-width:0;display:flex;flex-direction:column}
.case-entry.featured{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(1.5rem,4vw,3rem);align-items:center;padding:clamp(1.25rem,3vw,2.5rem);background:var(--brand-surface-soft)}
.case-photo{position:relative;display:block;aspect-ratio:4/3;background:var(--brand-surface-muted)}
.case-photo :global(img){width:100%;height:100%;object-fit:contain;object-position:center;filter:saturate(.65)}
.featured .case-photo{max-height:22rem}
.case-photo span{position:absolute;left:0;bottom:0;background:var(--brand-red);color:#fff;padding:.5rem 1rem;font-size:.75rem}
.case-copy{display:flex;flex-direction:column;flex:1;padding-top:1.5rem}
.featured .case-copy{padding-top:0}
.case-copy h2{font-size:var(--brand-type-card)}
.case-copy h2 a{text-decoration:none}
.case-copy h2 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em}
.case-copy>.ed-link{margin-top:auto}
.case-company{font-size:.8rem;font-weight:700}
.case-outcome{font-size:.9rem;color:var(--brand-muted)}
.case-copy dl{display:flex;flex-wrap:wrap;gap:1.5rem;margin:1.5rem 0}
.case-copy dt{font-size:.65rem;text-transform:uppercase;color:var(--brand-muted)}
.case-copy dd{margin:.3rem 0 0;font-size:.8rem}
@media(max-width:1024px){.case-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:800px){.case-filters{grid-template-columns:1fr 1fr}.case-entry.featured{grid-template-columns:1fr}.featured .case-photo{max-height:none}}
@media(max-width:600px){.case-grid,.case-filters{grid-template-columns:1fr}}
</style>
