---
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import PermitPathway from '../shared/PermitPathway.astro';
import IndustryTiles from '../shared/IndustryTiles.astro';
import {EXPERIENCES,experienceUrl} from '../../data/experiences';
import {experienceImages} from '../../data/experience-images';
import {SERVICE_CATEGORIES} from '../../data/service-catalog';
import {serviceById,serviceUrl} from '../../data/services';
import type {Locale} from '../../data/site';
interface Props{locale:Locale}const {locale}=Astro.props,id=locale==='id';
const industries=[...new Set(EXPERIENCES.map(e=>e.content[locale].industry))],stages=[...new Set(EXPERIENCES.map(e=>e.content[locale].stage))];
---
<BaseLayout locale={locale} title={id?'Studi Kasus Perizinan | Galdino & Partner':'Licensing Case Studies | Galdino & Partner'} description={id?'Telusuri konteks, pendekatan, dan hasil pendampingan perizinan lintas industri.':'Explore the context, approach and outcomes of licensing engagements across industries.'}>
<div class="editorial evidence-journal"><div class="container-shell">
<header class="journal-heading"><Breadcrumbs locale={locale} items={[{name:id?'Studi Kasus':'Case Studies'}]}/><div><h1>{id?'Studi kasus.':'Case studies.'}</h1><p>{id?'Konteks, proses, dan hasil kerja.':'Context, process and deliverables.'}</p></div></header>
<form class="case-filters" aria-label={id?'Filter studi kasus':'Case study filters'}>
<label>{id?'Industri':'Industry'}<select id="case-industry"><option value="">{id?'Semua industri':'All industries'}</option>{industries.map(x=><option value={x}>{x}</option>)}</select></label>
<label>{id?'Bidang layanan':'Practice area'}<select id="case-service"><option value="">{id?'Semua bidang':'All practice areas'}</option>{SERVICE_CATEGORIES.filter(cat=>EXPERIENCES.some(e=>e.services.some(s=>serviceById(s)?.category===cat.id))).map(cat=><option value={cat.id}>{cat.content[locale].title}</option>)}</select></label>
<label>{id?'Kebutuhan bisnis':'Business requirement'}<select id="case-stage"><option value="">{id?'Semua kebutuhan':'All requirements'}</option>{stages.map(x=><option value={x}>{x}</option>)}</select></label>
<button type="reset">{id?'Reset filter':'Reset filters'}</button></form>
<p id="case-count" class="ed-results" role="status" aria-live="polite">6 {id?'studi kasus':'case studies'}</p>
<div class="case-grid">{EXPERIENCES.map((e,n)=><article class:list={['case-entry',{featured:n===0,medium:n===1||n===2}]} data-case data-industry={e.content[locale].industry} data-categories={e.services.map(s=>serviceById(s)?.category).join(' ')} data-stage={e.content[locale].stage}>
<a class="case-photo" href={experienceUrl(e,locale)} tabindex="-1" aria-hidden="true"><Image src={experienceImages[e.imageKey]} alt="" widths={[480,800,1200]} sizes={n===0?'(min-width:800px) 55vw, 100vw':'(min-width:800px) 40vw, 100vw'} loading={n===0?'eager':'lazy'} fetchpriority={n===0?'high':'auto'} quality={78}/><span>0{n+1} / {e.year}</span></a>
<div class="case-copy"><p class="ed-kicker">{e.content[locale].industry}</p><h2><a href={experienceUrl(e,locale)}>{e.content[locale].title}</a></h2><p class="case-company">{e.company}</p><p class="case-outcome">{e.content[locale].outcome}</p><dl><div><dt>{id?'Lokasi':'Location'}</dt><dd>{e.location}</dd></div><div><dt>{id?'Durasi':'Duration'}</dt><dd>{e.content[locale].duration}</dd></div></dl><ul class="ed-tags">{e.services.slice(0,2).map(key=>{const s=serviceById(key)!;return <li><a href={serviceUrl(s,locale)}>{s.content[locale].title}</a></li>})}</ul><a class="ed-link" href={experienceUrl(e,locale)}>{id?'Baca studi kasus':'Read case study'} ↗</a></div>
</article>)}</div><div class="ed-empty" id="case-empty" hidden><h2>{id?'Belum ada kombinasi yang sesuai.':'No matching combination.'}</h2><p>{id?'Ubah salah satu filter atau reset untuk melihat semua studi kasus.':'Change a filter or reset to see all case studies.'}</p></div>
<section class="ed-section"><p class="ed-kicker">{id?'Pendekatan bersama':'A shared approach'}</p><h2>{id?'Konteks berbeda. Ketelitian yang sama.':'Different contexts. The same care.'}</h2><PermitPathway locale={locale}/></section>
<section class="ed-section"><p class="ed-kicker">{id?'Jelajahi konteksnya':'Explore the context'}</p><IndustryTiles locale={locale} limit={3}/></section>
</div><HomeFinalCta locale={locale}/></div></BaseLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('.case-filters'),entries=[...document.querySelectorAll<HTMLElement>('[data-case]')];
 const industry=document.querySelector<HTMLSelectElement>('#case-industry'),service=document.querySelector<HTMLSelectElement>('#case-service'),stage=document.querySelector<HTMLSelectElement>('#case-stage');
 function filterCases(){let count=0;entries.forEach(e=>{e.hidden=Boolean((industry?.value&&e.dataset.industry!==industry.value)||(service?.value&&!e.dataset.categories?.split(' ').includes(service.value))||(stage?.value&&e.dataset.stage!==stage.value));if(!e.hidden)count++;});const status=document.querySelector('#case-count');if(status)status.textContent=count+' '+(document.documentElement.lang==='id'?'studi kasus':'case studies');const empty=document.querySelector<HTMLElement>('#case-empty');if(empty)empty.hidden=count>0;}
 form?.addEventListener('submit',e=>e.preventDefault());form?.addEventListener('change',filterCases);form?.addEventListener('reset',()=>setTimeout(filterCases,0));
</script>
<style>.journal-heading{padding:3rem 0 1.5rem}.journal-heading>div{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:1rem}.journal-heading h1{font-size:clamp(2.5rem,4vw,4rem);margin:0}.journal-heading p{color:#56565b}.case-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;gap:1rem;align-items:end;border-block:1px solid #bcbab7;padding:1.2rem 0}.case-filters label{display:grid;gap:.5rem;font-size:.75rem;font-weight:700}.case-filters select{width:100%;min-width:0;background:transparent;border:1px solid #bcbab7;padding:.7rem;min-height:2.75rem;border-radius:0;font-size:.85rem;color:#171719}.case-filters button{min-height:2.75rem;padding:.7rem 1rem;border:0;background:#171719;color:white;font-size:.8rem;cursor:pointer}.case-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:3.5rem 2rem;margin:1.5rem 0 4rem}.case-entry{grid-column:span 2;min-width:0}.case-entry.featured{grid-column:1/-1;display:grid;grid-template-columns:1.3fr 1fr;gap:3rem;align-items:center;padding:0 0 3rem;border-bottom:1px solid #c9c8c5}.case-entry.medium{grid-column:span 3}.case-photo{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#ddd}.case-photo :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.45)}.case-photo span{position:absolute;left:0;bottom:0;background:#6c0e1b;color:#fff;padding:.5rem 1rem;font-size:.75rem}.case-copy{padding-top:1.5rem}.featured .case-copy{padding-top:0}.case-copy h2{font-size:clamp(1.5rem,2.4vw,2.2rem)}.featured h2{font-size:clamp(2rem,3.2vw,3.2rem)}.case-copy h2 a{text-decoration:none}.case-copy h2 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em}.case-company{font-size:.8rem;font-weight:700}.case-outcome{font-size:.9rem;color:#56565b}.case-copy dl{display:flex;flex-wrap:wrap;gap:1.5rem;margin:1.5rem 0}.case-copy dt{font-size:.65rem;text-transform:uppercase;color:#56565b}.case-copy dd{margin:.3rem 0 0;font-size:.8rem}@media(max-width:800px){.case-filters{grid-template-columns:1fr 1fr}.case-grid{grid-template-columns:1fr;gap:3rem}.case-entry,.case-entry.medium,.case-entry.featured{grid-column:auto}.case-entry.featured{display:block}.featured .case-copy{padding-top:1.5rem}}@media(max-width:480px){.case-filters{grid-template-columns:1fr}}</style>
