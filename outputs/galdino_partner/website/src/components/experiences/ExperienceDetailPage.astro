---
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageHero from '../shared/ImageHero.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import PermitPathway from '../shared/PermitPathway.astro';
import RelatedCases from '../shared/RelatedCases.astro';
import RelatedInsights from '../shared/RelatedInsights.astro';
import {EXPERIENCES,type Experience,experienceUrl} from '../../data/experiences';
import {experienceImages} from '../../data/experience-images';
import {serviceById,serviceUrl} from '../../data/services';
import {INDUSTRIES,industryUrl} from '../../data/industries';
import type {Locale} from '../../data/site';
interface Props{locale:Locale;experience:Experience}
const {locale,experience:e}=Astro.props,id=locale==='id',c=e.content[locale],related=e.services.map(s=>serviceById(s)!);
const industries=INDUSTRIES.filter(i=>i.services.some(s=>e.services.includes(s))).slice(0,3);
const secondary=experienceImages[e.imageKey==='compliance'?'licensing':'compliance'];
---
<BaseLayout immersive locale={locale} title={c.title+' | Galdino & Partner'} description={c.outcome} alternateUrl={experienceUrl(e,id?'en':'id')}>
<div class="editorial">
<ImageHero locale={locale} title={c.title} description={c.outcome} image={experienceImages[e.imageKey]} breadcrumbs={[{name:id?'Our Experiences':'Our Experiences',href:'/'+locale+'/projects/'},{name:e.company}]}/><div class="container-shell"><dl class="case-metadata"><div><dt>{id?'Lokasi':'Location'}</dt><dd>{e.location}</dd></div><div><dt>{id?'Durasi pendampingan':'Engagement duration'}</dt><dd>{c.duration}</dd></div><div><dt>{id?'Tahap usaha':'Business stage'}</dt><dd>{c.stage}</dd></div><div><dt>{id?'Ruang lingkup':'Scope'}</dt><dd>{related.map(s=>s.content[locale].title).join(' · ')}</dd></div></dl></div>
<div class="container-shell">
<section class="ed-section ed-split"><div><p class="ed-kicker">01 / {id?'Situasi & tantangan':'Situation & challenge'}</p><h2>{id?'Membaca kebutuhan sebelum menentukan langkah.':'Understand the need before deciding the next step.'}</h2></div><p class="ed-lead">{c.challenge}</p></section>
<section class="ed-section approach-layout"><figure class="ed-figure"><Image src={secondary} alt={id?'Review dan konsolidasi dokumen bersama tim':'Document review and consolidation with the team'} widths={[480,800,1200]} sizes="(min-width:800px) 50vw, 100vw" loading="lazy" quality={78}/></figure><div><p class="ed-kicker">02 / {id?'Pendekatan':'Approach'}</p><h2>{id?'Satu peta untuk pekerjaan bersama.':'One map for coordinated work.'}</h2><p class="ed-lead">{c.approach}</p><ul class="ed-list">{related.map(s=><li><a href={serviceUrl(s,locale)}>{s.content[locale].title}</a></li>)}</ul></div></section>
<section class="ed-section"><p class="ed-kicker">03 / {id?'Alur pendampingan':'Engagement pathway'}</p><h2>{id?'Dari asesmen hingga serah terima.':'From assessment to handover.'}</h2><PermitPathway locale={locale}/><p class="ed-note">{id?'Lingkup pendampingan berlangsung '+c.duration+'. Urutan mengikuti kelengkapan data; waktu keputusan instansi tidak menjadi jaminan proyek lain.':'This engagement scope took '+c.duration+'. Sequencing depends on complete records; authority decision timing is not a guarantee for other projects.'}</p></section>
<section class="ed-section result-layout"><div><p class="ed-kicker">04 / {id?'Hasil kerja':'Deliverables'}</p><h2>{id?'Bahan untuk langkah berikutnya.':'Ready for the next step.'}</h2><ol class="deliverables">{c.deliverables.map((x,n)=><li><span>0{n+1}</span>{x}</li>)}</ol></div><aside><p class="ed-kicker">{id?'Hasil pendampingan':'Engagement outcome'}</p><p class="result-statement">{c.outcome}</p><p class="internal-note">{id?'Catatan pendekatan: prioritas, status, dan pemilik tindak lanjut harus tetap terbaca setelah serah terima.':'Approach note: priorities, status and action owners should remain clear after handover.'}</p></aside></section>
<section class="ed-section"><h2>{id?'Layanan & konteks terkait':'Related services & contexts'}</h2><div class="ed-related">{related.map(s=><article><h3><a href={serviceUrl(s,locale)}>{s.content[locale].title}</a></h3><p>{s.content[locale].description}</p></article>)}</div><ul class="ed-tags">{industries.map(i=><li><a href={industryUrl(i,locale)}>{i.content[locale].short}</a></li>)}</ul></section>
<RelatedInsights locale={locale} services={e.services}/><RelatedCases locale={locale} cases={EXPERIENCES.filter(x=>x.slug!==e.slug).slice(0,2)}/>
</div><HomeFinalCta locale={locale}/></div></BaseLayout>
<style>.case-metadata{display:grid;grid-template-columns:1fr 1fr 1fr 1.5fr;gap:2rem;margin:3rem 0 0;padding:1.5rem 0 2.5rem;border-top:2px solid var(--brand-red)}.case-metadata dt{font-size:.66rem;color:#56565b;text-transform:uppercase}.case-metadata dd{margin:.6rem 0 0;font-size:.85rem}.approach-layout,.result-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:3rem;align-items:center}.approach-layout .ed-figure{height:100%}.approach-layout :global(img){height:100%;min-height:24rem}.result-layout{align-items:start}.deliverables{list-style:none;padding:0;margin:2rem 0}.deliverables li{display:flex;gap:1.3rem;border-top:1px solid #bcb8b5;padding:1.2rem 0;font-size:.95rem}.deliverables span{color:#951022;font-size:.75rem}.result-layout aside{padding:2rem;background:#e6e2dc;border-top:3px solid #ad172a}.result-statement{font-size:clamp(1.5rem,2.5vw,2.3rem);line-height:1.35;letter-spacing:-.03em}.internal-note{font-size:.8rem;color:#56565b;margin-top:2rem;border-top:1px solid #bbb5ae;padding-top:1rem}@media(max-width:800px){.case-metadata{grid-template-columns:1fr 1fr;gap:1.5rem}.approach-layout,.result-layout{grid-template-columns:1fr;gap:2rem}.approach-layout :global(img){min-height:0}}@media(max-width:400px){.case-metadata{grid-template-columns:1fr}}</style>
