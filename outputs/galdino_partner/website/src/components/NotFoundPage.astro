---
import BaseLayout from '../layouts/BaseLayout.astro';import type {Locale} from '../data/site';interface Props{locale:Locale}const {locale}=Astro.props;const id=locale==='id';
---
<BaseLayout locale={locale} title={id?'Halaman Tidak Ditemukan | Galdino & Partner':'Page Not Found | Galdino & Partner'} description={id?'Halaman yang Anda cari tidak tersedia. Telusuri layanan atau kembali ke beranda.':'The requested page is unavailable. Explore services or return home.'} alternateUrl={id?'/en/':'/id/'}><section class="editorial ed-hero"><div class="container-shell"><p class="ed-kicker">404</p><h1>{id?'Halaman ini tidak ditemukan.':'This page could not be found.'}</h1><p class="ed-lead">{id?'Alamat mungkin berubah atau halaman sudah tidak tersedia. Pilih langkah berikut untuk melanjutkan.':'The address may have changed or the page is unavailable. Choose where to go next.'}</p><div class="ed-actions"><a class="ed-button" href={`/${locale}/`}>{id?'Kembali ke Home':'Return home'}</a><a class="ed-link" href={`/${locale}/services/`}>{id?'Jelajahi layanan':'Explore services'} →</a></div></div></section></BaseLayout>