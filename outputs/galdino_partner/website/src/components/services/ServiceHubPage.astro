---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageHero from '../shared/ImageHero.astro';
import HomeFinalCta from '../home/HomeFinalCta.astro';
import PermitPathway from '../shared/PermitPathway.astro';
import RelatedCases from '../shared/RelatedCases.astro';
import RelatedInsights from '../shared/RelatedInsights.astro';
import ServiceDirectory from './ServiceDirectory.astro';
import {SERVICES} from '../../data/services';
import {EXPERIENCES} from '../../data/experiences';
import {SERVICE_GROUPS,categoryUrl,groupUrl,type ServiceCategory} from '../../data/service-catalog';
import {categoryActivityImage} from '../../data/service-images';
import type {Locale} from '../../data/site';
interface Props{locale:Locale;category:ServiceCategory}
const {locale,category}=Astro.props,id=locale==='id',c=category.content[locale];
const services=SERVICES.filter(s=>s.category===category.id),groups=SERVICE_GROUPS.filter(g=>g.category===category.id);
const cases=EXPERIENCES.filter(e=>e.services.some(key=>services.some(s=>s.id===key))).slice(0,2);
const documents=[...new Set(services.flatMap(s=>s.content[locale].documents.slice(-2)))];
const faq=id?[
 ['Layanan mana yang perlu dimulai lebih dahulu?',c.note],
 ['Apakah semua layanan di bidang ini wajib?', 'Tidak selalu. Kami meninjau kegiatan, skala, lokasi, dan dokumen yang sudah ada sebelum menentukan layanan serta urutan pekerjaan.'],
 ['Apa yang dibawa saat konsultasi awal?','Siapkan ringkasan kegiatan, alamat lokasi, tahap proyek, dan daftar dokumen yang tersedia. Persyaratan teknis khusus dapat dilihat pada masing-masing halaman jasa.'],
 ['Bagaimana ruang lingkup dan biaya disepakati?','Konsultasi awal gratis. Penawaran memisahkan jasa pendampingan, tenaga teknis, pengujian, serta biaya resmi atau lembaga. Pekerjaan dimulai setelah ruang lingkup dan biaya disepakati.'],
 ['Apakah persetujuan dan waktunya dijamin?','Keputusan tetap pada instansi atau lembaga yang berwenang. Jadwal mengikuti kelengkapan data, pemeriksaan, dan permintaan perbaikan.']
]:[
 ['Which service should come first?',c.note],
 ['Is every service in this area mandatory?','Not necessarily. We review the activity, scale, location and existing records before identifying the services and sequence.'],
 ['What should I bring to an initial consultation?','Prepare an activity summary, site address, project stage and available-document list. Each service page explains its specific technical requirements.'],
 ['How are scope and fees agreed?','The initial consultation is free. The quotation separates coordination, technical specialists, testing and official or external fees. Work begins after scope and fees are agreed.'],
 ['Are approval and timing guaranteed?','Decisions remain with the responsible authority or independent body. Timing depends on complete records, inspections and correction requests.']
];
---
<BaseLayout immersive locale={locale} title={(id?'Jasa ':'')+c.title+' | Galdino & Partner'} description={c.description} alternateUrl={categoryUrl(category,id?'en':'id')}>
<div class="editorial">
<ImageHero locale={locale} title={(id?'Jasa ':'')+c.title} description={c.description} image={categoryActivityImage(category.id).image} breadcrumbs={[{name:id?'Layanan':'Services',href:'/'+locale+'/services/'},{name:c.title}]}/>
<div class="container-shell">
<section class="ed-section ed-split"><div><h2>{id?'Pendampingan sesuai kebutuhan usaha.':'Support for your business requirements.'}</h2><p class="ed-lead">{c.note}</p><p>{id?'Galdino & Partner membantu meninjau kebutuhan, menyiapkan dokumen, dan mengoordinasikan proses dalam ruang lingkup yang disepakati.':'Galdino & Partner reviews requirements, prepares records and coordinates the process within an agreed scope.'}</p><a class="ed-button" href={'/'+locale+'/contact/'}>{id?'Konsultasi awal gratis':'Free initial consultation'} ↗</a></div><aside><h3>{id?'Siapa yang membutuhkan?':'Who needs this support?'}</h3><ul class="ed-list">{c.audience.map(x=><li>{x}</li>)}</ul><h3>{id?'Situasi yang perlu ditinjau':'Situations to review'}</h3><ul class="ed-list">{c.triggers.map(x=><li>{x}</li>)}</ul></aside></section>
{groups.length>0&&<nav class="group-index ed-actions" aria-label={id?'Kelompok layanan lingkungan':'Environmental service groups'}>{groups.map(g=><a class="ed-link" href={groupUrl(g,locale)}>{g.title[locale]} ↓</a>)}</nav>}
<section class="ed-section" id="services-in-category"><h2>{id?'Layanan dalam bidang ini.':'Services in this area.'}</h2>
{groups.length?groups.map(g=><section class="service-group" id={g.slug[locale]}><h3>{g.title[locale]}</h3><ServiceDirectory locale={locale} services={services.filter(s=>s.group===g.id)} listId={'services-'+g.id}/></section>):<ServiceDirectory locale={locale} services={services}/>}
</section>
<section class="ed-section"><p class="ed-kicker">{id?'Proses kerja':'Working process'}</p><h2>{id?'Dari asesmen hingga tindak lanjut.':'From assessment to follow-up.'}</h2><PermitPathway locale={locale} showNumbers={false}/></section>
<section class="ed-section ed-columns"><div><h2>{id?'Dokumen awal':'Initial documents'}</h2><ul class="ed-list">{documents.map(x=><li>{x}</li>)}</ul><p>{id?'Lengkapi dengan ringkasan kegiatan, lokasi, skala, dan tahap proyek. Setiap jasa memiliki persyaratan teknis tersendiri; buka halaman jasa untuk melihat rinciannya.':'Include an activity summary, location, scale and project stage. Each service has its own technical requirements; open its page for details.'}</p></div><div><h2>{id?'Masalah yang kami bantu petakan':'Issues we help clarify'}</h2><ul class="ed-list">{(id?['Dokumen tersebar atau statusnya belum jelas','Ketergantungan antarizin sebelum pengajuan berikutnya','Batas tugas pemohon, tenaga teknis, dan pendamping','Perubahan lokasi, kapasitas, atau kegiatan usaha']:['Scattered records or unclear document status','Permit dependencies before the next submission','Responsibilities of applicants, specialists and coordinators','Changes to location, capacity or activities']).map(x=><li>{x}</li>)}</ul></div></section>
{cases.length>0&&<RelatedCases locale={locale} cases={cases}/>}
<RelatedInsights locale={locale} services={services.map(s=>s.id)}/>
<section class="ed-section"><p class="ed-kicker">FAQ</p><h2>{id?'Sebelum Anda memulai.':'Before you begin.'}</h2>{faq.map(([q,a])=><details class="ed-details"><summary>{q}</summary><p>{a}</p></details>)}</section>
</div><HomeFinalCta locale={locale}/></div></BaseLayout>
<style>.service-group{padding-top:2rem;scroll-margin-top:7rem}.service-group+.service-group{margin-top:2rem}.group-index{gap:.5rem 1.5rem}</style>
