---
import {Image} from 'astro:assets';
import {categoryImages} from '../../data/industry-images';
import PermitPathway from '../shared/PermitPathway.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';import Breadcrumbs from '../shared/Breadcrumbs.astro';import HomeFinalCta from '../home/HomeFinalCta.astro';import ServiceDirectory from './ServiceDirectory.astro';import {SERVICES} from '../../data/services';import {SERVICE_GROUPS,categoryUrl,groupUrl,type ServiceCategory,type ServiceGroup} from '../../data/service-catalog';import type {Locale} from '../../data/site';
interface Props{locale:Locale;category:ServiceCategory;group?:ServiceGroup}const {locale,category,group}=Astro.props;const id=locale==='id',c=category.content[locale],title=group?group.title[locale]:c.title;
const services=SERVICES.filter(s=>s.category===category.id&&(!group||s.group===group.id)),groups=group?[]:SERVICE_GROUPS.filter(g=>g.category===category.id),other=id?'en':'id';
const crumbs=[{name:id?'Layanan':'Services',href:`/${locale}/services/`},...(group?[{name:c.title,href:categoryUrl(category,locale)}]:[]),{name:title}];
---
<BaseLayout locale={locale} title={title+' | Galdino & Partner'} description={c.description} alternateUrl={group?groupUrl(group,other):categoryUrl(category,other)}><div class="editorial"><header class="ed-hero"><div class="container-shell"><Breadcrumbs locale={locale} items={crumbs}/><p class="ed-kicker">{id?'Bidang layanan':'Practice area'} / {category.number}</p><h1>{title}</h1><p class="ed-lead">{c.description}</p><div class="ed-actions"><a class="ed-button" href={`/${locale}/contact/`}>{id?'Konsultasi awal gratis':'Free initial consultation'} ↗</a><a class="ed-link" href="#service-list">{id?'Jelajahi layanan':'Explore services'} ↓</a></div><figure class="detail-visual"><Image src={categoryImages[category.id]} alt={title} widths={[640,1000,1440]} sizes="100vw" loading="eager" quality={78}/></figure></div></header><div class="container-shell">
<section class="ed-section ed-split"><div><h2>{id?'Satu konteks, beberapa kebutuhan.':'One context, connected requirements.'}</h2><p class="ed-lead">{c.note}</p></div><aside><h3>{id?'Biasanya diperlukan oleh':'Commonly needed by'}</h3><ul class="ed-list">{c.audience.map(x=><li>{x}</li>)}</ul><h3>{id?'Mulai ketika':'Start when'}</h3><ul class="ed-list">{c.triggers.map(x=><li>{x}</li>)}</ul></aside></section>
{groups.length>0&&<section class="ed-section"><h2>{id?'Pilih tahap kebutuhan lingkungan.':'Choose your environmental requirement.'}</h2><div class="ed-related">{groups.map(g=><article><h3><a href={groupUrl(g,locale)}>{g.title[locale]}</a></h3><p>{SERVICES.filter(s=>s.group===g.id).length} {id?'layanan terkait':'related services'}</p></article>)}</div></section>}
<section class="ed-section"><h2>{id?'Layanan dalam bidang ini.':'Services in this area.'}</h2><ServiceDirectory locale={locale} services={services}/></section><section class="ed-section"><p class="ed-kicker">{id?'Alur pendampingan':'Engagement pathway'}</p><PermitPathway locale={locale}/></section><section class="ed-section ed-columns"><div><h2>{id?'Apa yang perlu disiapkan?':'What should you prepare?'}</h2><p>{id?'Mulai dengan ringkasan kegiatan, lokasi, tahap proyek, dan daftar dokumen yang sudah tersedia. Kami memeriksa hubungan antarizin sebelum menetapkan urutan pekerjaan.':'Start with an activity summary, location, project stage and available-document list. We review permit dependencies before sequencing the work.'}</p></div><div><h2>{id?'Scope yang disepakati.':'An agreed scope.'}</h2><p>{id?'Penawaran memisahkan pekerjaan kami, pekerjaan tenaga teknis, dan biaya lembaga atau instansi. Keputusan persetujuan tetap berada pada pihak berwenang.':'The quotation separates our work, technical specialists and external fees. Approval decisions remain with the responsible bodies.'}</p><a class="ed-link" href={`/${locale}/profile/how-we-work/`}>{id?'Pelajari cara kerja':'How we work'} ↗</a></div></section></div><HomeFinalCta locale={locale}/></div></BaseLayout>