---
import {serviceActivityImage} from '../../data/service-images';
import {Image} from 'astro:assets';
import {categoryImages} from '../../data/industry-images';
import BaseLayout from '../../layouts/BaseLayout.astro';import SplitHero from '../shared/SplitHero.astro';import ContextSection from '../shared/ContextSection.astro';import RelatedInsights from '../shared/RelatedInsights.astro';import HomeFinalCta from '../home/HomeFinalCta.astro';
import RelatedCases from '../shared/RelatedCases.astro';
import {EXPERIENCES} from '../../data/experiences';
import {SERVICES,serviceUrl,priceLabel,type Service} from '../../data/services';import {PEOPLE} from '../../data/people';import type {Locale} from '../../data/site';
interface Props{locale:Locale;service:Service}const {locale,service:s}=Astro.props;const id=locale==='id',c=s.content[locale];const other=id?'en':'id';
const experts=PEOPLE[locale].filter(p=>p.services.includes(s.id));
const related=SERVICES.filter(x=>s.related.includes(x.id));
const categoryServices=SERVICES.filter(x=>x.category===s.category).map(x=>x.id);
const cases=EXPERIENCES.filter(e=>e.services.some(key=>categoryServices.includes(key))).sort((a,b)=>Number(b.services.includes(s.id))-Number(a.services.includes(s.id))).slice(0,2);
const faq=id?[
 ['Apakah konsultasi awal berbayar?','Konsultasi awal gratis. Kami membahas kegiatan, lokasi, dan tujuan Anda sebelum menetapkan ruang lingkup tertulis.'],
 ['Dokumen mana yang perlu disiapkan lebih dahulu?',c.documents.slice(0,3).join(', ')+'. Kirim ringkasan kebutuhan terlebih dahulu; dokumen sensitif diminta melalui kanal yang disepakati.'],
 ['Apa yang termasuk estimasi biaya?',c.priceScope+' Cakupan final dan pengecualian disepakati sebelum pekerjaan dimulai.'],
 ['Apakah waktu penyelesaian dapat dipastikan?',c.timeline+' adalah perkiraan pekerjaan kami setelah data lengkap. Verifikasi, permintaan perbaikan, dan keputusan instansi dapat menambah waktu.'],
 ['Apakah hasil permohonan dijamin?','Tidak. Kami menyiapkan dan mengawal proses sesuai lingkup yang disepakati. Keputusan berada pada instansi atau lembaga yang berwenang.'],
 ['Bagaimana jika kebutuhan saya melibatkan izin lain?','Kami memetakan hubungan izin dan menyusun urutan pekerjaan. Pengurusan di luar ruang lingkup awal hanya dilakukan setelah biaya dan langkah tambahan disepakati.'],
]:[
 ['Is the first consultation free?','Yes. We discuss your activities, location and objectives before agreeing a written scope.'],
 ['Which documents should I prepare first?',c.documents.slice(0,3).join(', ')+'. Send a brief first; sensitive documents are requested through an agreed channel.'],
 ['What does the starting price cover?',c.priceScope+' The final scope and exclusions are agreed before work starts.'],
 ['Can the completion date be guaranteed?',c.timeline+' is an estimate for our work after receiving complete information. Authority checks, revisions and decisions may add time.'],
 ['Is approval guaranteed?','No. We prepare and coordinate the agreed work. Decisions remain with the relevant authority or certifying body.'],
 ['What if other permits are required?','We map dependencies and sequence the work. Additional handling only proceeds after the scope and fees are agreed.'],
];
const schema={'@context':'https://schema.org','@type':'Service',name:c.title,description:c.description,serviceType:c.title,areaServed:{'@type':'Country',name:'Indonesia'},provider:{'@type':'Organization',name:'Galdino & Partner',url:Astro.site}};
---
<BaseLayout immersive locale={locale} title={`${c.title} — ${priceLabel(s,locale)} | Galdino & Partner`} description={c.description+' '+(id?'Pelajari dokumen, proses, biaya jasa, dan langkah konsultasi awal gratis.':'Explore documents, process, professional fees and a free initial consultation.')} alternateUrl={serviceUrl(s,other)}>
<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
<div class="editorial" data-page-event="service_view" data-entity={s.id}>
<SplitHero title={c.title} description={c.description} image={serviceActivityImage(s).image} alt={serviceActivityImage(s).alt[locale]} href="#service-scope" action={id?'Lihat cakupan pengurusan':'View the engagement scope'}/><div class="container-shell"><ContextSection locale={locale} title={id?'Pahami kebutuhan '+c.title.replace(/^Jasa /,'').toLowerCase()+'.':'Understand your '+c.title.toLowerCase()+' requirements.'} intro={c.definition} detail={c.why+' '+(id?'Pendampingan relevan untuk ':'Support is relevant for ')+c.audience.join(', ')+'. '+(id?'Mulai saat ':'Start when ')+c.triggers.join('; ')+'.'} href={`/${locale}/contact/?service=${s.id}`}/>
<section class="ed-section ed-columns" id="service-scope"><div><p class="ed-kicker">{id?'Ruang lingkup':'Scope'}</p><h2>{id?'Pekerjaan yang kami tangani.':'The work we coordinate.'}</h2><ul class="ed-list">{c.scope.map(x=><li>{x}</li>)}</ul></div><div><p class="ed-kicker">{id?'Hasil kerja':'Deliverables'}</p><h2>{id?'Yang Anda terima.':'What you receive.'}</h2><ul class="ed-list">{c.deliverables.map(x=><li>{x}</li>)}</ul></div></section>
<section class="ed-section ed-split"><div><h2>{id?'Dokumen yang biasanya diperlukan.':'Documents typically required.'}</h2><ul class="ed-list">{c.documents.map(x=><li>{x}</li>)}</ul><p>{id?'Kebutuhan akhir mengikuti kondisi usaha. Dokumen diperiksa untuk kelengkapan, konsistensi nama, alamat, kegiatan, dan kewenangan penandatangan.':'Final requirements depend on your business. We review completeness and consistency of names, addresses, activities and signing authority.'}</p></div><aside><figure class="ed-figure"><Image src={categoryImages[s.category]} alt={id?'Konteks fasilitas dan kegiatan usaha':'Business activity and facility context'} widths={[400,700]} sizes="(min-width:800px) 35vw, 100vw" loading="lazy" quality={72}/></figure><p class="ed-note">{id?'Ceritakan kebutuhan tanpa mengirim identitas atau dokumen sensitif melalui formulir awal. Kami akan menyepakati kanal dokumen setelah konsultasi.':'Describe your requirement without sending identity documents or sensitive records in the initial form. A document channel is agreed after consultation.'}</p></aside></section>
<section class="ed-section"><p class="ed-kicker">{id?'Proses':'Process'}</p><h2>{id?'Dari konteks hingga tindak lanjut.':'From context to follow-through.'}</h2><ol class="process-list">{(id?[['Konsultasi awal','Kami meninjau kegiatan, lokasi, struktur, dan tujuan usaha.'],['Asesmen dokumen','Data yang tersedia dibandingkan dengan kebutuhan: '+c.documents.slice(0,2).join(' dan ')+'.'],['Scope dan penawaran','Ruang lingkup, pemilik dokumen, biaya, serta batas pekerjaan disepakati tertulis.'],['Persiapan dan koordinasi',c.scope.slice(1).join('; ')+'.'],['Serah terima dan tindak lanjut','Arsip, status, dan kewajiban berikutnya diserahkan. Hal yang belum selesai dicatat beserta penanggung jawabnya.']]:[['Initial consultation','We review activities, location, structure and business objectives.'],['Document assessment','Available records are checked against requirements: '+c.documents.slice(0,2).join(' and ')+'.'],['Scope and quotation','Scope, document owners, fees and boundaries are agreed in writing.'],['Preparation and coordination',c.scope.slice(1).join('; ')+'.'],['Handover and follow-up','Records, status and next obligations are handed over. Open issues are recorded with their owners.']]).map(([a,b])=><li><h3>{a}</h3><p>{b}</p></li>)}</ol></section>
<section class="ed-section ed-columns"><div><h2>{id?'Estimasi waktu':'Estimated timing'}</h2><p class="ed-price">{c.timeline}</p><p>{id?'Estimasi dihitung setelah data lengkap dan ruang lingkup disetujui. Waktu review instansi, pemeriksaan lapangan, koreksi, dan penerbitan keputusan berada di luar kendali kami.':'Estimates begin after complete information and scope approval. Authority review, site inspections, corrections and decisions are outside our control.'}</p></div><div><h2>{id?'Biaya yang transparan.':'A clear view of fees.'}</h2><p class="ed-price">{priceLabel(s,locale)}</p><p>{c.priceScope}</p><h3>{id?'Yang memengaruhi biaya':'What affects the fee'}</h3><ul class="ed-list">{(id?['Kompleksitas entitas dan jumlah klasifikasi','Wilayah, lokasi, dan jumlah fasilitas','Tingkat risiko dan persyaratan sektor','Kelengkapan data dan kebutuhan pihak ketiga']:['Entity complexity and number of classifications','Region, location and number of facilities','Risk level and sector requirements','Data completeness and third-party work']).map(x=><li>{x}</li>)}</ul></div></section>
<p class="ed-note">{id?'Biaya jasa profesional berbeda dari PNBP, notaris, laboratorium, konsultan teknis, retribusi, pajak, dan biaya pihak ketiga. Semua komponen tersebut dirinci terpisah; tidak ada biaya tambahan yang dijalankan tanpa kesepakatan.':'Professional fees are separate from government fees, notary, laboratory, technical consultants, levies, taxes and third-party costs. These are itemised separately; additional paid work requires agreement.'}</p>
<section class="ed-section"><p class="ed-kicker">FAQ</p><h2>{id?'Sebelum Anda memulai.':'Before you begin.'}</h2>{faq.map(([q,a])=><details class="ed-details"><summary>{q}</summary><p>{a}</p></details>)}</section>
<section class="ed-section"><h2>{id?'Kebutuhan yang berkaitan.':'Connected requirements.'}</h2><div class="ed-related">{related.map(r=><article><h3><a data-event="service_related_click" data-entity={r.id} href={serviceUrl(r,locale)}>{r.content[locale].title}</a></h3><p>{r.content[locale].description}</p></article>)}</div></section>
{cases.length>0&&<RelatedCases locale={locale} cases={cases}/>}<RelatedInsights locale={locale} services={[s.id]}/>
<section class="ed-section"><h2>{id?'Tim terkait':'Related team'}</h2><div class="ed-related">{(experts.length?experts:PEOPLE[locale].slice(0,1)).map(p=><article><h3><a href={`/${locale}/profile/${p.slug}/`}>{p.name}</a></h3><p>{p.role}</p></article>)}</div></section>
</div><HomeFinalCta locale={locale}/></div></BaseLayout>
<style>.service-estimate .ed-aside{max-width:55rem}.service-estimate .ed-price{color:var(--brand-red)}.process-list{list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1.4rem;padding:0;margin-top:2rem;border-top:1px solid #b8b3ae}.process-list li{padding-top:1.3rem}.process-list h3{font-size:1.1rem}.process-list li::marker{color:#a61227;font-size:.85rem;font-weight:800}.process-list p{font-size:.82rem;color:#56565b}@media(max-width:800px){.process-list{grid-template-columns:1fr}}</style>
