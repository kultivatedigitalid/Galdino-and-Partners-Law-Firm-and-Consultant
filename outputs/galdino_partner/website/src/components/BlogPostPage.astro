---
import {render} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import Breadcrumbs from './shared/Breadcrumbs.astro';import HomeFinalCta from './home/HomeFinalCta.astro';import {getPublishedPosts,postUrl,type BlogEntry} from '../utils/blog';import {SERVICES,serviceUrl} from '../data/services';
interface Props{post:BlogEntry}const {post}=Astro.props;const {Content,headings}=await render(post);const locale=post.data.locale,id=locale==='id';const all=await getPublishedPosts(locale),related=all.filter(p=>p.id!==post.id).sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,3);const translation=(await getPublishedPosts(id?'en':'id')).find(p=>p.data.translationKey===post.data.translationKey);const services=SERVICES.filter(s=>post.data.services.includes(s.id));const minutes=Math.max(1,Math.ceil((post.body||'').split(/\s+/).length/200));const date=(d:Date)=>new Intl.DateTimeFormat(id?'id-ID':'en-GB',{dateStyle:'long'}).format(d);const url=new URL(postUrl(post),Astro.site).toString();const schema={'@context':'https://schema.org','@type':'Article',headline:post.data.title,description:post.data.description,datePublished:post.data.publishDate.toISOString(),dateModified:(post.data.updatedDate||post.data.publishDate).toISOString(),author:{'@type':'Person',name:post.data.author},publisher:{'@type':'Organization',name:'Galdino & Partner'},inLanguage:locale,mainEntityOfPage:url,image:new URL(post.data.featuredImage,Astro.site)};
---
<BaseLayout locale={locale} title={post.data.title+' | Galdino & Partner'} description={post.data.description} image={post.data.featuredImage} type="article" alternateUrl={translation?postUrl(translation):undefined}><script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><article class="editorial" data-page-event="article_view" data-entity={post.data.translationKey}><header class="ed-hero"><div class="container-shell"><Breadcrumbs locale={locale} items={[{name:'Insight',href:`/${locale}/blog/`},{name:post.data.title}]}/><p class="ed-kicker">{post.data.category}</p><h1>{post.data.title}</h1><p class="ed-lead">{post.data.description}</p><div class="article-meta"><span>{post.data.author}</span><span>{id?'Terbit':'Published'} <time datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time></span>{post.data.updatedDate&&<span>{id?'Diperbarui':'Updated'} <time datetime={post.data.updatedDate.toISOString()}>{date(post.data.updatedDate)}</time></span>}<span>{minutes} {id?'menit baca':'min read'}</span></div><ul class="ed-tags">{post.data.tags.map(t=><li>{t}</li>)}</ul></div></header>
<div class="container-shell"><div class="ed-section article-body"><aside class="ed-toc"><h2>{id?'Dalam artikel ini':'In this article'}</h2><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol>{translation&&<a class="ed-link" data-preserve-scroll href={postUrl(translation)}>{id?'Read in English':'Baca Bahasa Indonesia'} ↗</a>}</aside><div><div class="ed-story"><Content/></div><section class="article-sources"><h2>{id?'Sumber & referensi':'Sources & references'}</h2><ul class="ed-list">{post.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a></li>)}</ul><p class="ed-note">{id?'Informasi umum, bukan nasihat hukum untuk keadaan tertentu. Kebutuhan akhir mengikuti lokasi, kegiatan, dokumen, dan ketentuan yang berlaku saat pengajuan.':'General information, not legal advice for a specific situation. Final requirements depend on location, activity, documents and rules applicable at submission.'}</p></section><div class="ed-actions share-actions"><span>{id?'Bagikan':'Share'}</span><a class="ed-link" href={'https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(url)} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="ed-link" href={'https://wa.me/?text='+encodeURIComponent(post.data.title+' '+url)} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><button type="button" class="ed-button secondary" data-copy-article data-url={url}>{id?'Salin tautan':'Copy link'}</button><span role="status" data-copy-status></span></div></div></div>
{services.length>0&&<section class="ed-section"><p class="ed-kicker">{id?'Dari pemahaman ke tindakan':'From understanding to action'}</p><h2>{id?'Layanan yang berkaitan.':'Related services.'}</h2><div class="ed-related">{services.map(s=><article><h3><a data-event="article_service_click" data-entity={s.id} href={serviceUrl(s,locale)}>{s.content[locale].title}</a></h3><p>{s.content[locale].description}</p></article>)}</div></section>}
<section class="ed-section"><h2>{id?'Lanjutkan membaca.':'Continue reading.'}</h2><div class="ed-related">{related.map(p=><article><p class="ed-label">{p.data.category}</p><h3><a href={postUrl(p)}>{p.data.title}</a></h3><p>{p.data.description}</p></article>)}</div></section></div><HomeFinalCta locale={locale}/></article></BaseLayout>
<style>.article-meta{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;margin:2rem 0 1rem;font-size:.76rem;color:#56565b}.article-body{display:grid;grid-template-columns:15rem minmax(0,1fr);gap:5rem;align-items:start}.article-sources{margin-top:3rem;border-top:1px solid #c9c8c5;padding-top:2rem}.article-sources h2{font-size:1.5rem}.article-sources a{overflow-wrap:anywhere}.share-actions{font-size:.8rem}.share-actions button{font-size:.8rem}@media(max-width:900px){.article-body{grid-template-columns:1fr;gap:2rem}.ed-toc{position:static}}</style>
<script>document.querySelector<HTMLButtonElement>('[data-copy-article]')?.addEventListener('click',async event=>{const b=event.currentTarget as HTMLButtonElement,s=document.querySelector('[data-copy-status]'),id=document.documentElement.lang==='id';try{await navigator.clipboard.writeText(b.dataset.url||location.href);if(s)s.textContent=id?'Tautan disalin.':'Link copied.';}catch{if(s)s.textContent=id?'Silakan salin alamat dari bilah browser.':'Please copy the address from your browser.';}});</script>