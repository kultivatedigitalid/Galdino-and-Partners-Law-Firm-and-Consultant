---
import {ARTICLE_HEADLINES} from '../data/hero-headlines';
import {blogImage} from '../data/blog-images';
import InsightCard from './blog/InsightCard.astro';
import {render} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {Image} from 'astro:assets';
import HomeFinalCta from './home/HomeFinalCta.astro';
import {getPublishedPosts,postUrl,type BlogEntry} from '../utils/blog';
import {SERVICES,serviceUrl} from '../data/services';
interface Props{post:BlogEntry}
const {post}=Astro.props;
const {Content,headings}=await render(post);
const locale=post.data.locale,id=locale==='id',image=blogImage(post);
const all=await getPublishedPosts(locale),related=all.filter(p=>p.id!==post.id).sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,3);
const translation=(await getPublishedPosts(id?'en':'id')).find(p=>p.data.translationKey===post.data.translationKey);
const services=SERVICES.filter(s=>post.data.services.includes(s.id));
const date=(d:Date)=>new Intl.DateTimeFormat(id?'id-ID':'en-GB',{dateStyle:'long'}).format(d);
const url=new URL(postUrl(post),Astro.site).toString();
const schema={'@context':'https://schema.org','@type':'Article',headline:post.data.title,description:post.data.description,datePublished:post.data.publishDate.toISOString(),dateModified:(post.data.updatedDate||post.data.publishDate).toISOString(),author:{'@type':'Person',name:post.data.author},publisher:{'@type':'Organization',name:'Galdino & Partner'},inLanguage:locale,mainEntityOfPage:url,image:new URL(image.src,Astro.site).toString()};
---
<BaseLayout immersive={false} locale={locale} title={post.data.title+' | Galdino & Partner'} description={post.data.description} image={image.src} type="article" alternateUrl={translation?postUrl(translation):undefined}>
 <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
 <article class="editorial blog-article" data-page-event="article_view" data-entity={post.data.translationKey}>
  <header class="article-header" data-hero-motion="ready">
   <div class="article-reader">
    <a class="article-back" href={`/${locale}/blog/`}>← {id?'Kembali ke Insight':'Back to Insight'}</a>
    <div class="article-meta" data-hero-part="action"><span class="article-category">{post.data.category}</span><time datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time><span>{post.data.author}</span></div>
    <h1 data-hero-part="title">{ARTICLE_HEADLINES[post.data.translationKey]?.[locale]||post.data.title}</h1>
    <p class="article-description" data-hero-part="lead">{post.data.description}</p>
    {post.data.updatedDate&&<p class="article-updated">{id?'Diperbarui':'Updated'} <time datetime={post.data.updatedDate.toISOString()}>{date(post.data.updatedDate)}</time></p>}
    <figure class="article-cover" data-hero-part="visual"><Image src={image} alt={post.data.title} widths={[640,960,1280]} sizes="(min-width:900px) 54rem,100vw" loading="eager" fetchpriority="high" quality={85}/></figure>
   </div>
  </header>
  <div class="container-shell article-content">
   <div class="article-body">
    <aside class="ed-toc"><h2>{id?'Dalam artikel ini':'In this article'}</h2><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol>{translation&&<a class="ed-link" data-preserve-scroll href={postUrl(translation)}>{id?'Read in English':'Baca Bahasa Indonesia'} →</a>}</aside>
    <div class="article-main">
     <div class="ed-story"><Content/></div>
     <section class="article-sources"><h2>{id?'Sumber & referensi':'Sources & references'}</h2><ul class="ed-list">{post.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} →</a></li>)}</ul><p class="ed-note">{id?'Informasi umum, bukan nasihat hukum untuk keadaan tertentu. Kebutuhan akhir mengikuti lokasi, kegiatan, dokumen, dan ketentuan yang berlaku saat pengajuan.':'General information, not legal advice for a specific situation. Final requirements depend on location, activity, documents and rules applicable at submission.'}</p></section>
     <div class="ed-actions share-actions"><span>{id?'Bagikan':'Share'}</span><a class="ed-link" href={'https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(url)} target="_blank" rel="noopener noreferrer">LinkedIn →</a><a class="ed-link" href={'https://wa.me/?text='+encodeURIComponent(post.data.title+' '+url)} target="_blank" rel="noopener noreferrer">WhatsApp →</a><button type="button" class="ed-button secondary" data-copy-article data-url={url}>{id?'Salin tautan':'Copy link'}</button><span role="status" data-copy-status></span></div>
     <footer class="article-author"><p>{id?'Ditulis oleh':'Written by'}</p><strong>{post.data.author}</strong><span>Galdino &amp; Partner</span></footer>
    </div>
   </div>
   {services.length>0&&<section class="article-followup"><h2>{id?'Layanan yang berkaitan.':'Related services.'}</h2><div class="ed-related">{services.map(s=><article><h3><a data-event="article_service_click" data-entity={s.id} href={serviceUrl(s,locale)}>{s.content[locale].title}</a></h3><p>{s.content[locale].description}</p><a class="ed-link" href={serviceUrl(s,locale)}>{id?'Lihat layanan':'Explore service'} →</a></article>)}</div></section>}
   <section class="article-followup"><h2>{id?'Lanjutkan membaca.':'Continue reading.'}</h2><div class="article-related-grid">{related.map(p=><InsightCard post={p}/>)}</div></section>
  </div>
  <HomeFinalCta locale={locale}/>
 </article>
</BaseLayout>
<style>
 .blog-article{background:var(--brand-paper)}
 .article-header{padding:clamp(3rem,5vw,5rem) 0 0;background:var(--brand-paper);color:var(--brand-black)}
 .article-reader{width:min(calc(100% - 2.5rem),54rem);margin-inline:auto}
 .article-back{display:inline-flex;align-items:center;min-height:2.75rem;margin-bottom:1.5rem;color:var(--brand-muted);font-size:.8rem;text-decoration:none}
 .article-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.5rem;font-size:.8rem;font-weight:650;color:var(--brand-muted)}
 .article-category{color:var(--brand-red)}
 .article-header h1{max-width:none;margin:1.5rem 0;font-size:clamp(2.25rem,3.5vw,3.5rem);font-weight:570;line-height:1.08;letter-spacing:-.035em;text-wrap:balance}
 .article-description{margin:0;max-width:65ch;font-size:var(--brand-type-lead);color:var(--brand-muted);line-height:1.7}
 .article-updated{margin:1rem 0 0;font-size:.75rem;color:var(--brand-muted)}
 .article-cover{margin:clamp(2rem,4vw,3.5rem) 0 0;aspect-ratio:16/9;overflow:hidden;border-radius:var(--brand-cta-radius)}
 .article-cover :global(img){width:100%;height:100%;object-fit:cover}
 .article-content{max-width:70rem}
 .article-body{display:grid;grid-template-columns:13rem minmax(0,1fr);gap:clamp(2rem,4vw,4rem);align-items:start;padding-top:clamp(3rem,5vw,5rem)}
 .article-main{min-width:0;max-width:70ch}.article-main :global(.ed-story){max-width:70ch;font-size:1.05rem;line-height:1.85}
 .article-sources{margin-top:3rem;border-top:1px solid var(--brand-line);padding-top:2rem}.article-sources h2{font-size:1.5rem;line-height:1.2}.article-sources a{overflow-wrap:anywhere}
 .share-actions{font-size:.8rem}.share-actions button{font-size:.8rem}
 .article-author{display:flex;flex-direction:column;gap:.4rem;margin-top:3rem;padding-block:2rem;border-block:1px solid var(--brand-line);background:transparent;color:var(--brand-black)}
 .article-author p,.article-author span{margin:0;color:var(--brand-muted);font-size:.8rem}.article-author strong{font-size:1.15rem}
 .article-followup{padding-block:clamp(4rem,6vw,6rem)}.article-followup h2{margin-bottom:2rem;font-size:clamp(2rem,3.5vw,3rem)}
 .article-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}
 @media(max-width:900px){.article-body{grid-template-columns:1fr;gap:2.5rem}.ed-toc{position:static}.article-main{max-width:none}.article-related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:600px){.article-reader{width:calc(100% - 1.25rem)}.article-related-grid{grid-template-columns:1fr}.article-header h1{font-size:clamp(2rem,8vw,2.75rem)}.article-body{padding-top:3rem}.article-followup{padding-block:3rem}}
</style>
<script>
 document.querySelector<HTMLButtonElement>('[data-copy-article]')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement,status=document.querySelector('[data-copy-status]'),id=document.documentElement.lang==='id';try{await navigator.clipboard.writeText(button.dataset.url||location.href);if(status)status.textContent=id?'Tautan disalin.':'Link copied.';}catch{if(status)status.textContent=id?'Silakan salin alamat dari bilah browser.':'Please copy the address from your browser.';}});
</script>
