---
import {heroImages} from '../data/hero-images';
import BaseLayout from '../layouts/BaseLayout.astro';import ImageHero from './shared/ImageHero.astro';import ContactForm from './ContactForm.astro';import ContactNextSteps from './contact/ContactNextSteps.astro';import {SITE,type Locale} from '../data/site';
interface Props{locale:Locale}const {locale}=Astro.props;const id=locale==='id';
---
<BaseLayout immersive locale={locale} title={id?'Konsultasi Awal Gratis | Galdino & Partner':'Free Initial Consultation | Galdino & Partner'} description={id?'Diskusikan kebutuhan legalitas dan perizinan bisnis. Konsultasi awal gratis melalui formulir, email, atau WhatsApp.':'Discuss business legal and licensing requirements. Free initial consultation through the form, email or WhatsApp.'}>
<div class="editorial"><ImageHero locale={locale} title={id?'Rencana Anda. Langkah berikutnya.':'Your plans. The next step.'} description={id?'Konsultasi awal gratis. Ceritakan kegiatan usaha dan kebutuhan Anda. Kami membantu menentukan apa yang perlu disiapkan terlebih dahulu.':'The first consultation is free. Tell us about your activities and requirements. We help identify what to prepare first.'} image={heroImages.contact} mobileImage={heroImages.contactMobile} breadcrumbs={[{name:id?'Konsultasi':'Consultation'}]}/>
<section class="ed-section"><div class="container-shell contact-layout"><aside><p class="ed-kicker">{id?'Hubungi langsung':'Direct contact'}</p><h2>{id?'Mulai dari konteks yang jelas.':'Start with clear context.'}</h2><p>{id?'Isi formulir atau gunakan saluran yang paling nyaman. Kami meninjau kebutuhan sebelum mengusulkan ruang lingkup pekerjaan.':'Use the form or your preferred channel. We review requirements before proposing a scope of work.'}</p><address><a class="ed-link" href={SITE.whatsappHref}>WhatsApp ↗</a><br/><a class="ed-link" href={`mailto:${SITE.email}`}>{SITE.email}</a><p>{SITE.address}</p><p>{id?'Senin–Jumat, 09.00–17.00 WIB':'Monday–Friday, 09:00–17:00 WIB'}</p><a class="ed-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.address)}`} target="_blank" rel="noopener noreferrer">{id?'Lihat lokasi':'View location'} ↗</a></address></aside><ContactForm locale={locale}/></div></section>
<div class="container-shell"><ContactNextSteps locale={locale}/></div></div></BaseLayout>
<style>.contact-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.4fr);gap:clamp(2rem,5vw,5rem)}aside p{color:#56565b;font-size:.95rem}address{font-style:normal;border-top:1px solid #b9b8b5;margin-top:2rem;padding-top:1rem;overflow-wrap:anywhere}@media(max-width:900px){.contact-layout{grid-template-columns:1fr}}</style>
