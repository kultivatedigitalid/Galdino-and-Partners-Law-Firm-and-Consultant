---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';
import ContactNextSteps from './contact/ContactNextSteps.astro';
import {SITE,type Locale} from '../data/site';
interface Props{locale:Locale}
const {locale}=Astro.props,id=locale==='id';
---
<BaseLayout locale={locale} title={id?'Konsultasi Awal Gratis | Galdino & Partner':'Free Initial Consultation | Galdino & Partner'} description={id?'Diskusikan kebutuhan legalitas dan perizinan bisnis. Konsultasi awal gratis melalui formulir, email, atau WhatsApp.':'Discuss business legal and licensing requirements. Free initial consultation through the form, email or WhatsApp.'}>
<div class="editorial contact-page"><section class="container-shell contact-layout" aria-labelledby="contact-title"><div class="contact-copy"><h1 id="contact-title">{id?'Mulai dengan Konsultasi Gratis.':'Start with a Free Consultation.'}</h1><p class="ed-lead">{id?'Ceritakan kegiatan, lokasi, dan kebutuhan izin Anda. Kami memahami konteks terlebih dahulu, lalu menjelaskan ruang lingkup dan estimasi biaya yang diperlukan.':'Tell us about your activities, location and permit requirements. We first understand the context, then explain the scope and estimated fees you need.'}</p><ContactNextSteps locale={locale}/><address><h2>{id?'Hubungi langsung':'Direct contact'}</h2><a class="ed-link" href={SITE.whatsappHref}>WhatsApp →</a><br/><a class="ed-link" href={`mailto:${SITE.email}`}>{SITE.email}</a><p>{SITE.address}</p><p>{id?'Senin–Jumat, 09.00–17.00 WIB':'Monday–Friday, 09:00–17:00 WIB'}</p><a class="ed-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.address)}`} target="_blank" rel="noopener noreferrer">{id?'Lihat lokasi':'View location'} →</a></address></div><ContactForm locale={locale}/></section></div>
</BaseLayout>
<style>.contact-page{padding:clamp(7rem,10vw,9rem) 0 var(--brand-section-space)}.contact-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(2.5rem,6vw,6rem);align-items:start}.contact-copy h1{margin:0;max-width:15ch}.contact-copy>p{color:var(--brand-muted);line-height:1.65;margin-top:1.5rem}.contact-copy address{font-style:normal;border-top:1px solid var(--brand-line-strong);margin-top:2rem;padding-top:1.5rem;overflow-wrap:anywhere}.contact-copy address h2{font-size:var(--brand-type-card)}.contact-copy address p{color:var(--brand-muted);font-size:.9rem}@media(max-width:900px){.contact-layout{grid-template-columns:1fr}}</style>
