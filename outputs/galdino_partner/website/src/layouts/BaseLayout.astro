---
import '../styles/global.css';
import '../styles/contrast.css';
import '../styles/profile-polish.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  alternateUrl?: string;
}
const { locale, title, description, image = '/og-default.svg', type = 'website', alternateUrl } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = locale === 'id' ? 'en' : 'id';
const fallbackAlternate = new URL(Astro.url.pathname.replace(/^\/(id|en)/, `/${other}`), Astro.site);
const resolvedAlternate = new URL(alternateUrl || fallbackAlternate.toString(), Astro.site).toString();
const alternateNavigationPath = new URL(resolvedAlternate).pathname;
const defaultLocaleUrl = locale === 'id' ? canonical : resolvedAlternate;
const ogImage = new URL(image, Astro.site);
const pathname = Astro.url.pathname;
const usesRedBrand = pathname === `/${locale}/` || pathname.startsWith(`/${locale}/profile/`);
const organizationLogo = '/assets/gp-logo-brand.png';
const organization = {
  '@context': 'https://schema.org',
  '@type': ['LegalService', 'Organization'],
  name: 'Galdino & Partner',
  url: Astro.site,
  logo: new URL(organizationLogo, Astro.site),
  email: 'kultivatedigitalid@gmail.com',
  telephone: '+62-821-2592-4637',
  areaServed: 'Indonesia',
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={usesRedBrand ? '#c4142a' : '#103638'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={resolvedAlternate} />
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Galdino & Partner" />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} alternateUrl={alternateNavigationPath} />
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <ContactDock locale={locale} />
    <script>
      document.documentElement.classList.add('motion-ready');
      const observer = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries, instance) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                instance.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 })
        : null;
      document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => observer ? observer.observe(element) : element.classList.add('is-visible'));
    </script>
  </body>
</html>
