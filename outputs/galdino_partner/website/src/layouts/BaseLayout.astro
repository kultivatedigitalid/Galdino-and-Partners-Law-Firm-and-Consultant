---
import '../styles/global.css';
import '../styles/editorial.css';
import {SITE} from '../data/site';
import {CONTACT} from '../data/contact';
import {canIndex} from '../data/launch';
import CookieConsent from '../components/legal/CookieConsent.astro';
import '../styles/contrast.css';
import '../styles/profile-polish.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
  immersive?: boolean;
  showHeader?: boolean;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  alternateUrl?: string;
}
const { showHeader = true, immersive, locale, title, description, image = '/og-default.png', type = 'website', alternateUrl } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = locale === 'id' ? 'en' : 'id';
const fallbackAlternate = new URL(Astro.url.pathname.replace(/^\/(id|en)/, `/${other}`), Astro.site);
const resolvedAlternate = new URL(alternateUrl || fallbackAlternate.toString(), Astro.site).toString();
const alternateNavigationPath = new URL(resolvedAlternate).pathname;
const defaultLocaleUrl = locale === 'id' ? canonical : resolvedAlternate;
const ogImage = new URL(image, Astro.site);


const indexable = canIndex(Astro.site) && Astro.response.status!==404;
const organizationLogo = '/assets/gp-logo-brand.png';
const organization = {
  '@context': 'https://schema.org',
  '@type': ['LegalService', 'Organization'],
  name: 'Galdino & Partner',
  url: Astro.site,
  logo: new URL(organizationLogo, Astro.site),
  email: SITE.email,
  telephone: SITE.whatsappDisplay,
  legalName: SITE.legalName,
  description: 'Legal & Licensing Consultant',
  address: {'@type':'PostalAddress',streetAddress:SITE.address,addressLocality:'Tangerang Selatan',addressCountry:'ID'},
  openingHours: CONTACT.hours,
  areaServed: 'Indonesia',
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c4142a" />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'id' ? 'id-ID' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={other === 'id' ? 'id-ID' : 'en'} href={resolvedAlternate} />
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Galdino & Partner" />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage}/>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[{'@type':'WebSite',name:SITE.displayName,url:Astro.site},{'@type':'WebPage',name:title,description,url:canonical,inLanguage:locale}]})}/>
    <slot name="head" />
  </head>
  <body>
    {showHeader && <Header immersive={immersive} locale={locale} alternateUrl={alternateNavigationPath} />}
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <ContactDock locale={locale} />
    <CookieConsent locale={locale} />
    <script>
      import '../scripts/dialogs';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ready');
      const observer = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries, instance) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                instance.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 })
        : null;
      document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => observer ? observer.observe(element) : element.classList.add('is-visible'));
    </script>
  </body>
</html>
