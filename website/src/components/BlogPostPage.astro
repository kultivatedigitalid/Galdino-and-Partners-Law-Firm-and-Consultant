---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import { getPublishedPosts, postUrl, type BlogEntry } from '../utils/blog';
interface Props { post: BlogEntry; }
const { post } = Astro.props;
const { Content } = await render(post);
const locale = post.data.locale;
const id = locale === 'id';
const allPosts = await getPublishedPosts(locale);
const related = allPosts.filter((item) => item.id !== post.id && (item.data.category === post.data.category || item.data.tags.some((tag) => post.data.tags.includes(tag)))).slice(0, 2);
const translation = (await getPublishedPosts(locale === 'id' ? 'en' : 'id')).find((item) => item.data.translationKey === post.data.translationKey);
const published = new Intl.DateTimeFormat(id ? 'id-ID' : 'en-US', { dateStyle: 'long' }).format(post.data.publishDate);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: 'Galdino & Partner' },
  inLanguage: locale,
  mainEntityOfPage: new URL(postUrl(post), Astro.site),
};
---
<BaseLayout locale={locale} title={`${post.data.title} | Galdino & Partner`} description={post.data.description} type="article" image={post.data.featuredImage} alternateUrl={translation ? new URL(postUrl(translation), Astro.site).toString() : undefined}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article>
    <header class="border-b border-line bg-white">
      <div class="container-shell py-16 md:py-24">
        <a class="text-xs font-bold uppercase tracking-wider text-forest" href={`/${locale}/blog/`}>← {id ? 'Kembali ke insight' : 'Back to insights'}</a>
        <p class="eyebrow mt-10">{post.data.category}</p>
        <h1 class="display mt-7 max-w-5xl">{post.data.title}</h1>
        <p class="mt-7 max-w-3xl text-lg text-muted">{post.data.description}</p>
        <div class="mt-8 flex flex-wrap gap-5 text-xs text-muted">
          <span>{post.data.author}</span>
          <time datetime={post.data.publishDate.toISOString()}>{published}</time>
          <span>{post.data.tags.map((tag) => `#${tag}`).join(' · ')}</span>
        </div>
      </div>
    </header>
    <div class="container-shell grid gap-12 py-14 lg:grid-cols-[1fr_16rem]">
      <div class="prose-legal"><Content /></div>
      <aside class="h-fit border-l border-line pl-5 text-xs text-muted">
        <p class="font-bold uppercase tracking-wider text-ink">{id ? 'Catatan' : 'Notice'}</p>
        <p class="mt-3">{id ? 'Artikel ini bersifat informasi umum. Kondisi setiap bisnis dapat menghasilkan kewajiban yang berbeda.' : 'This article provides general information. Each business may be subject to different obligations.'}</p>
        {translation && <a class="mt-5 block font-bold text-forest underline" href={postUrl(translation)}>{id ? 'Read in English' : 'Baca dalam Bahasa Indonesia'} →</a>}
      </aside>
    </div>
  </article>
  {related.length > 0 && <section class="border-t border-line bg-white section-space"><div class="container-shell"><h2 class="heading">{id ? 'Artikel terkait' : 'Related articles'}</h2><div class="mt-8">{related.map((item) => <ArticleCard post={item} />)}</div></div></section>}
</BaseLayout>
